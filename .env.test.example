# Copie para .env.test antes de rodar `npm run test:integration` localmente
# (scripts/test/prepare-integration-env.js faz essa cópia automaticamente se o
# arquivo não existir). Valores aqui batem com as credenciais que
# scripts/db/docker-init.sh cria no Postgres do docker-compose.yml — não são
# segredos reais, só dev/test local.
NODE_ENV=test
DATABASE_URL=postgresql://prospector_app:prospector_app_pass@localhost:5434/prospectordb
REDIS_URL=redis://:prospector_redis_pass@localhost:6379
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=atlasgr_meili_master_key
