# Copie para .env.test antes de rodar `npm run test:integration` localmente
# (scripts/test/prepare-integration-env.js faz essa cópia automaticamente se o
# arquivo não existir, e também cria o banco "prospectordb_test" abaixo se ele
# ainda não existir). Valores aqui batem com as credenciais que
# scripts/db/docker-init.sh cria no Postgres do docker-compose.yml — não são
# segredos reais, só dev/test local.
#
# IMPORTANTE: o banco é "prospectordb_test", não "prospectordb". O
# pretest:integration roda `prisma migrate deploy`, que já é seguro por si só,
# mas testes de integração fazem create/delete de linhas de verdade — rodar
# isso contra o banco de dev compartilhado misturaria dados de teste com os
# seus. Mesmo nome que o CI usa (ver .github/workflows/ci.yml).
NODE_ENV=test
PORT=3000
DATABASE_URL=postgresql://prospector_app:prospector_app_pass@localhost:5434/prospectordb_test
REDIS_URL=redis://:prospector_redis_pass@localhost:6379
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=atlasgr_meili_master_key
# start:e2e (npm run test:e2e) sobe o servidor Express real com este .env.test — better-auth
# precisa de um secret pra assinar cookie de sessão. Dev/test only, não é usado em produção.
BETTER_AUTH_SECRET=e2e-test-only-secret-not-for-production
ALLOWED_ORIGINS=http://localhost:3000
ALLOW_DEV_AUTH_BYPASS=true
# O default de produção (20/15min) é seguro contra força bruta, mas a suíte E2E cria uma conta
# real por spec sequencialmente (helpers.ts signUp()) — mais de 20 specs esgotavam a cota e todo
# signUp() seguinte travava esperando um redirect que o rate limit nunca deixava acontecer
# (page.waitForURL timeout). Mesmo valor que .github/workflows/ci.yml já usa para o CI.
AUTH_RATE_LIMIT_MAX=500
