generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum CompanyStatus {
  Ativo
  Inativo
  Em_analise @map("Em análise")
}

enum MarketIntelligenceDatasetStatus {
  PENDING
  PROCESSING
  VALIDATING
  READY
  FAILED
  ARCHIVED
}

enum MarketIntelligenceIcpTier {
  MUITO_ALTO
  ALTO
  MEDIO
  BAIXO
  FORA_DO_ICP
}

enum MarketIntelligenceDataOrigin {
  OBSERVED
  DERIVED
  ESTIMATED
  SIMULATED
  NOT_AVAILABLE
}

enum ContactStatus {
  Ativo
  Inativo
}

enum LeadStatus {
  Lead_Recebido                  @map("Lead Recebido")
  Cadencia_Iniciada              @map("Cadência Iniciada")
  Qualificacao_SDR               @map("Qualificação (SDR)")
  Reuniao_Agendada               @map("Reunião Agendada")
  Lead_Desqualificado            @map("Lead Desqualificado")
  Convertido_em_Oportunidade     @map("Convertido em Oportunidade")
  Nova_Oportunidade              @map("Nova Oportunidade")
  Proposta_Enviada               @map("Proposta Enviada")
  Call_Visita_Agendada           @map("Call/Visita Agendada")
  // Etapas do funil Negócio adicionadas pela migration 20260805220000_two_funnels_and_bitrix_fields
  // (pipeline de pilotos comerciais) — não têm mapeamento de UI ainda, só refletem o que já está no banco.
  Piloto_VTECH                   @map("Piloto VTECH")
  Piloto_Atlas_Profile           @map("Piloto Atlas Profile")
  Piloto_Atlas_Profile_Concluido @map("Piloto Atlas Profile - Concluído")
  Piloto_Atlas_Profile_Cancelado @map("Piloto Atlas Profile - Cancelado")
  Piloto_Logistica               @map("Piloto Logística")
  Piloto_Logistico_Concluido     @map("Piloto Logístico - Concluído")
  Piloto_Logistico_Cancelado     @map("Piloto Logístico - Cancelado")
  Negocios_Perdidos              @map("Negócios Perdidos")
  Negocios_Ganhos                @map("Negócios Ganhos")
}

// Funil do objeto Lead x funil do objeto Negócio no Bitrix24 (ver migration
// 20260805220000_two_funnels_and_bitrix_fields) — cada Lead pertence a um dos dois.
enum LeadFunnel {
  Lead
  Negocio
}

enum LeadTemperature {
  Frio
  Morno
  Quente
}

enum ActivityType {
  Ligacao   @map("Ligação")
  WhatsApp
  Email     @map("E-mail")
  Reuniao   @map("Reunião")
  Follow_up @map("Follow-up")
  Visita
  Tarefa
}

enum ActivityStatus {
  Pendente
  Em_andamento @map("Em andamento")
  Concluida    @map("Concluída")
  Cancelada
}

enum CrmPipelineEntity {
  Lead
  Negocio
  SmartProcess
}

enum CrmProductType {
  Produto
  Servico
}

enum CrmDocumentType {
  Orcamento
  Proposta
  Fatura
  Contrato
}

enum UserRole {
  ADMIN
  GESTOR
  CLOSER
  SDR
  VISUALIZADOR
}

enum CrmDocumentStatus {
  Rascunho
  Enviado
  Visualizado
  Aceito
  Recusado
  Vencido
  Pago
  Cancelado
}

/// Classifica a natureza epistemica de cada item do LDR. O valor fica estruturado no banco para
/// que fato observado, inferencia e recomendacao nunca dependam de convencao em texto livre.
///
/// CPI — item "Enum de evidencia incompleto": ESTIMATE/UNKNOWN/CONFLICT adicionados nesta rodada
/// (migration prisma/migrations/20260826140000_expand_intelligence_evidence_type) porque o LDR
/// real produz esses tres casos e nao tinha onde representa-los sem forcar um valor errado
/// (ex.: uma confianca desconhecida sendo gravada como FACT). RECOMMENDATION nao e um tipo
/// epistemico de dado (fato/inferencia/estimativa/desconhecido/conflito descrevem a natureza de
/// uma OBSERVACAO; recomendacao e uma SAIDA/acao sugerida a partir de observacoes) — e
/// semanticamente estranho no mesmo enum, mas nao foi removido nesta rodada: e valor already em
/// uso por AccountSignal.evidenceType/DecisionMaker.roleEvidenceType e remove-lo exige investigar
/// e migrar quem grava esse valor hoje, fora do escopo aditivo pedido (so ADICIONAR os que
/// faltam). Ver relatorio da tarefa para o registro completo desta decisao.
enum IntelligenceEvidenceType {
  FACT
  INFERENCE
  RECOMMENDATION
  ESTIMATE
  UNKNOWN
  CONFLICT
}

enum IntelligenceSnapshotStatus {
  Complete
  Partial
  Failed
  Stale
}

enum AccountSignalStatus {
  Active
  Dismissed
  Expired
}

enum DecisionMakerStatus {
  Active
  Inactive
  Unverified
}

enum AccountRecommendationStatus {
  Pending
  Approved
  Executed
  Dismissed
  Superseded
  Failed
}

enum EconomicRelationshipStatus {
  Verified
  Inferred
  Rejected
  Inactive
}

model Company {
  id                String        @id @default(cuid())
  legalName         String
  tradeName         String
  cnpj              String?
  stateRegistration String?
  segment           String?
  cnae              String?
  size              String?
  employeeCount     Int?
  estimatedRevenue  Float?
  website           String?
  linkedin          String?
  instagram         String?
  twitter           String?
  facebook          String?
  phones            String[]
  emails            String[]
  address           String?
  city              String?
  state             String?
  zipCode           String?
  owner             String?
  status            CompanyStatus @default(Ativo)
  tags              String[]
  observations      String?
  customFields      Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Enrichment (Receita Federal / BrasilAPI + heurísticas)
  situacaoCadastral String?
  naturezaJuridica  String?
  capitalSocial     Float?
  dataAbertura      DateTime?
  qsa               Json?
  enrichmentStatus  String    @default("Pendente") // Pendente | Enriquecendo | Enriquecido | Falhou
  enrichmentSource  String?
  enrichedAt        DateTime?

  // Google Maps / My Business Enrichment
  googleRating       Float?
  googleReviewsCount Int?
  businessHours      Json?

  // Apollo Organization Enrich — firmographics reais além do que a Receita Federal expõe
  technologies String[]
  keywords     String[]
  logoUrl      String?
  apolloOrgId  String?

  // Menções recentes na imprensa (GDELT, gratuito/sem chave) — array de { title, url, domain, seenAt }
  newsMentions Json?

  // Look-alike scoring (pgvector) — embedding do perfil firmográfico (mesma técnica/dimensão do
  // KnowledgeChunk), usado para medir semelhança com empresas que já fecharam negócio. Não é
  // treinado — é distância de cosseno contra os "vizinhos" reais mais próximos (ver
  // lookalike-scoring.service.ts). lookalikeTopMatches guarda os matches usados, pra ser auditável
  // como o resto do enriquecimento em vez de um número sem explicação.
  profileEmbedding    Unsupported("vector(768)")?
  lookalikeScore      Float?
  lookalikeTopMatches Json?

  contacts                    Contact[]
  leads                       Lead[]
  prospects                   Prospect[]
  commercialDocuments         CrmCommercialDocument[]
  enrichmentLogs              EnrichmentLog[]
  intelligenceSnapshots       AccountIntelligenceSnapshot[]
  accountSignals              AccountSignal[]
  decisionMakers              DecisionMaker[]
  intelligenceEvidence        IntelligenceEvidence[]
  accountScores               AccountScore[]
  accountRecommendations      AccountRecommendation[]
  sourceEconomicRelationships EconomicRelationship[]        @relation("EconomicRelationshipSource")
  targetEconomicRelationships EconomicRelationship[]        @relation("EconomicRelationshipTarget")
  organizationId              String?
  organization                Organization?                 @relation(fields: [organizationId], references: [id])
  deletedAt                   DateTime?
  deletedBy                   String?
  deleteReason                String?

  // Permite FKs compostas nas tabelas de Account Intelligence: uma linha tenant-scoped nunca
  // pode apontar para uma Company de outra organizacao, mesmo sob bypass administrativo.
  @@unique([id, organizationId])
  // Garante em nível de banco que uma organização não tem duas empresas com o mesmo CNPJ —
  // antes só a aplicação evitava isso (companyIdentity.service.ts), sem nenhuma trava no schema
  // (achado real, Onda 43: um segundo write path já criava duplicata silenciosa por comparar
  // formatos diferentes do mesmo CNPJ). Só funciona porque todo write path de `cnpj` agora
  // normaliza pra dígitos puros antes de gravar (src/lib/cnpj.ts) — Postgres não deduplica
  // "12.345.678/0001-99" e "12345678000199" sozinho. NULL nunca colide com outro NULL (empresas
  // sem CNPJ continuam livres), e a constraint cobre inclusive linhas com soft delete
  // (`deletedAt` preenchido) de propósito — mesmo comportamento que `resolveCompanyIdentity` já
  // usa pra achar duplicata (não reabre o CNPJ de uma empresa só porque foi soft-deletada).
  @@unique([organizationId, cnpj])
  @@index([organizationId])
  @@index([cnpj])
  @@index([legalName])
  @@index([tradeName])
}

/// Snapshot rastreável e global. Só o importador com bypass de RLS pode gravar/publicar.
model MarketIntelligenceDataset {
  id              String                          @id
  dataset         String
  competencia     String
  source          String
  sourceVersion   String?
  sourceUrl       String?
  status          MarketIntelligenceDatasetStatus @default(PENDING)
  publicationSlot String?                         @unique
  startedAt       DateTime?
  finishedAt      DateTime?
  activatedAt     DateTime?
  recordsRead     BigInt                          @default(0)
  recordsImported BigInt                          @default(0)
  recordsRejected BigInt                          @default(0)
  recordsActive   BigInt                          @default(0)
  hash            String
  pipelineVersion String
  outputManifest  Json?
  error           String?                         @db.Text
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt
  companies       MarketIntelligenceCompany[]

  @@unique([dataset, competencia, hash])
  @@index([dataset, status, competencia])
  @@index([competencia])
}

