generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model KnowledgeDocument {
  id        String                      @id @default(uuid())
  title     String
  content   String                      @db.Text
  embedding Unsupported("vector(768)")?
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
}

enum CompanyStatus {
  Ativo
  Inativo
  Em_analise @map("Em análise")
}

enum ContactStatus {
  Ativo
  Inativo
}

enum LeadStatus {
  Lead_Recebido                  @map("Lead Recebido")
  Cadencia_Iniciada              @map("Cadência Iniciada")
  Qualificacao_SDR               @map("Qualificação (SDR)")
  Reuniao_Agendada               @map("Reunião Agendada")
  Lead_Desqualificado            @map("Lead Desqualificado")
  Convertido_em_Oportunidade     @map("Convertido em Oportunidade")
  Nova_Oportunidade              @map("Nova Oportunidade")
  Proposta_Enviada               @map("Proposta Enviada")
  Call_Visita_Agendada           @map("Call/Visita Agendada")
  // Etapas do funil Negócio adicionadas pela migration 20260805220000_two_funnels_and_bitrix_fields
  // (pipeline de pilotos comerciais) — não têm mapeamento de UI ainda, só refletem o que já está no banco.
  Piloto_VTECH                   @map("Piloto VTECH")
  Piloto_Atlas_Profile           @map("Piloto Atlas Profile")
  Piloto_Atlas_Profile_Concluido @map("Piloto Atlas Profile - Concluído")
  Piloto_Atlas_Profile_Cancelado @map("Piloto Atlas Profile - Cancelado")
  Piloto_Logistica               @map("Piloto Logística")
  Piloto_Logistico_Concluido     @map("Piloto Logístico - Concluído")
  Piloto_Logistico_Cancelado     @map("Piloto Logístico - Cancelado")
  Negocios_Perdidos              @map("Negócios Perdidos")
  Negocios_Ganhos                @map("Negócios Ganhos")
}

// Funil do objeto Lead x funil do objeto Negócio no Bitrix24 (ver migration
// 20260805220000_two_funnels_and_bitrix_fields) — cada Lead pertence a um dos dois.
enum LeadFunnel {
  Lead
  Negocio
}

enum LeadTemperature {
  Frio
  Morno
  Quente
}

enum ActivityType {
  Ligacao   @map("Ligação")
  WhatsApp
  Email     @map("E-mail")
  Reuniao   @map("Reunião")
  Follow_up @map("Follow-up")
  Visita
  Tarefa
}

enum ActivityStatus {
  Pendente
  Em_andamento @map("Em andamento")
  Concluida    @map("Concluída")
  Cancelada
}

enum CrmPipelineEntity {
  Lead
  Negocio
  SmartProcess
}

enum CrmProductType {
  Produto
  Servico
}

enum CrmDocumentType {
  Orcamento
  Proposta
  Fatura
  Contrato
}

enum CrmDocumentStatus {
  Rascunho
  Enviado
  Visualizado
  Aceito
  Recusado
  Vencido
  Pago
  Cancelado
}

model Company {
  id                String        @id @default(cuid())
  legalName         String
  tradeName         String
  cnpj              String?
  stateRegistration String?
  segment           String?
  cnae              String?
  size              String?
  employeeCount     Int?
  estimatedRevenue  Float?
  website           String?
  linkedin          String?
  instagram         String?
  twitter           String?
  facebook          String?
  phones            String[]
  emails            String[]
  address           String?
  city              String?
  state             String?
  zipCode           String?
  owner             String?
  status            CompanyStatus @default(Ativo)
  tags              String[]
  observations      String?
  customFields      Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Enrichment (Receita Federal / BrasilAPI + heurísticas)
  situacaoCadastral String?
  naturezaJuridica  String?
  capitalSocial     Float?
  dataAbertura      DateTime?
  qsa               Json?
  enrichmentStatus  String    @default("Pendente") // Pendente | Enriquecendo | Enriquecido | Falhou
  enrichmentSource  String?
  enrichedAt        DateTime?

  // Google Maps / My Business Enrichment
  googleRating       Float?
  googleReviewsCount Int?
  businessHours      Json?

  // Apollo Organization Enrich — firmographics reais além do que a Receita Federal expõe
  technologies String[]
  keywords     String[]
  logoUrl      String?
  apolloOrgId  String?

  // Menções recentes na imprensa (GDELT, gratuito/sem chave) — array de { title, url, domain, seenAt }
  newsMentions Json?

  // Look-alike scoring (pgvector) — embedding do perfil firmográfico (mesma técnica/dimensão do
  // KnowledgeChunk), usado para medir semelhança com empresas que já fecharam negócio. Não é
  // treinado — é distância de cosseno contra os "vizinhos" reais mais próximos (ver
  // lookalike-scoring.service.ts). lookalikeTopMatches guarda os matches usados, pra ser auditável
  // como o resto do enriquecimento em vez de um número sem explicação.
  profileEmbedding    Unsupported("vector(768)")?
  lookalikeScore      Float?
  lookalikeTopMatches Json?

  contacts            Contact[]
  leads               Lead[]
  commercialDocuments CrmCommercialDocument[]
  enrichmentLogs      EnrichmentLog[]
  organizationId      String?
  organization        Organization?           @relation(fields: [organizationId], references: [id])
  deletedAt           DateTime?
  deletedBy           String?
  deleteReason        String?

  @@index([organizationId])
  @@index([cnpj])
  @@index([legalName])
}

model EnrichmentLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source    String // BrasilAPI-CNPJ | BrasilAPI-CEP | AI-Estimate | Domain-Heuristic | GDELT-News | Email-Verification | Lookalike-PgVector
  field     String // o que foi enriquecido (ex: "dados-cadastrais", "endereco", "contatos-sugeridos")
  status    String // success | not_found | failed
  rawData   Json?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

model Contact {
  id           String        @id @default(cuid())
  name         String
  role         String?
  department   String?
  phone        String?
  whatsapp     String?
  email        String?
  linkedin     String?
  birthDate    DateTime?
  observations String?
  status       ContactStatus @default(Ativo)
  source       String? // ex: "Apollo", "Hunter"
  seniority    String? // ex: "c_suite", "vp", "director", "manager" — vindo da Apollo/Hunter
  emailStatus  String? // ex: "verified", "guessed" — confiabilidade do e-mail encontrado

  customFields        Json?
  commercialDocuments CrmCommercialDocument[]

  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads            Lead[]
  whatsAppMessages WhatsAppMessage[]
  organizationId   String?
  organization     Organization?     @relation(fields: [organizationId], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  @@index([organizationId])
  @@index([email])
}

model Lead {
  id String @id @default(cuid())

  // New CRM fields
  status          LeadStatus       @default(Lead_Recebido)
  source          String?
  channel         String?
  temperature     LeadTemperature?
  score           Int?
  owner           String?
  lastInteraction DateTime?
  nextAction      DateTime?
  // Quando o lead entrou em Fechado_Ganho/Fechado_Perdido, setado só nessa transição de status
  // (ver PrismaLeadRepository.updateStatus). Métricas de "ganho/perdido no mês" (analytics.service.ts)
  // não podem usar `updatedAt` pra isso: esse campo é @updatedAt e sobe em QUALQUER update do
  // registro (sync do Bitrix, uma ligação do SDR de voz tocando só lastInteraction, etc.), não só
  // em mudança de status — um lead fechado em março podia contar como "ganho em agosto" só porque
  // outra coisa tocou nele depois. Volta a null se o lead for reaberto pra uma etapa não-final.
  closedAt        DateTime?
  // PIC (Perfil de Cliente Ideal) do Playbook de Pré-Vendas Atlas — setado manualmente pelo SDR/AM
  // após identificar o gatilho real na conversa (não é inferido automaticamente): "PIC1_Expansao"
  // (transportadora em expansão operacional), "PIC2_Risco" (sob pressão de risco/sinistro), ou
  // "PIC3_Transicao" (transição de liderança/reestruturação).
  pic             String?
  // Checklist de qualificação do SDR (Playbook Comercial AtlasGR, seção 4.2) — contexto
  // operacional, estrutura atual, dor mapeada, interesse/autoridade e próximo passo. Estruturado
  // como JSON (ver LeadQualification no frontend) em vez de ~20 colunas separadas.
  qualification   Json?
  title           String?
  amount          Float?
  currency        String           @default("BRL")
  probability     Int?
  expectedCloseAt DateTime?
  customFields    Json?

  // Funil do Lead (objeto Lead x objeto Negócio do Bitrix24) e campos comerciais que só existiam
  // no Bitrix — ver migration 20260805220000_two_funnels_and_bitrix_fields para o remapeamento
  // dos dados existentes. Ainda não lidos/escritos pelo PrismaLeadRepository (fora do escopo desta
  // sincronização de schema).
  funnel                     LeadFunnel @default(Lead)
  resumeDate                 DateTime?
  cadenceStage               String?
  lossReason                 String?
  dealPackage                String?
  dealStatus                 String?
  relationshipLevel          String?
  commissionPercent          String?
  partnerBroker              String?
  qualificationValidatedByAM Boolean?

  // Sincronização bidirecional com o Bitrix24 (ver bitrix.service.ts) — o ID do Lead lá no
  // portal do cliente. Sem isso, cada rodada de importação recriaria os mesmos 99+ leads de novo
  // (não há outra chave natural: nome de empresa se repete, telefone pode faltar). Não é @unique
  // "hard" porque cada organização fala com o SEU PRÓPRIO portal Bitrix — múltiplos tenants nunca
  // colidem no mesmo ID na prática, mas travar isso com constraint global é desnecessário.
  bitrixLeadId     String?
  // Mesma ideia de bitrixLeadId, mas para importação a partir do objeto Deal (Negócio) do Bitrix
  // — usado quando a organização importa pelo funil de vendas real (com pipeline/etapa), não pelo
  // objeto Lead cru. Campo separado porque IDs de Lead e Deal são namespaces distintos no Bitrix
  // (podem colidir numericamente sem ter nenhuma relação entre si).
  bitrixDealId     String?
  // Nome da etapa como está no Bitrix (ex: "Novo Lead (Distribuidoras)" para Lead, ou "Proposta
  // Enviada" para Deal) — preservado à parte do `status` mapeado pro enum interno, porque o
  // Bitrix tem estágios/categorias específicas do negócio do cliente que não têm equivalente 1:1
  // no nosso LeadStatus fixo.
  bitrixStageLabel String?
  // Data de assinatura do contrato — UF_CRM_1770928318695 no objeto Lead do Bitrix (achado em
  // public/tools/extrator-bitrix.html, fora do BITRIX_FIELD_MAP original). Não existe código
  // equivalente conhecido no objeto Deal.
  contractSignedDate DateTime?

  // Status de sincronização OUTBOUND (Atlas → Bitrix) — fecha a lacuna descrita em
  // outboundSync.ts/pushLeadToBitrix: antes disso uma falha no push automático só existia no log,
  // nunca na tela. 'pending' = nunca sincronizado; 'syncing' = claim em andamento (trava de
  // concorrência, ver syncLeadToBitrix); 'synced' = última tentativa teve sucesso; 'failed' =
  // última tentativa falhou (bitrixSyncError carrega o motivo).
  bitrixSyncStatus String?
  bitrixSyncError  String?   @db.Text
  bitrixSyncedAt   DateTime?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  pipelineId      String?
  pipeline        CrmPipeline?      @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  pipelineStageId String?
  pipelineStage   CrmPipelineStage? @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)

  activities          Activity[]
  timeline            TimelineEvent[]
  internalNotes       Note[]
  whatsAppMessages    WhatsAppMessage[]
  conversationSignals ConversationSignal[]
  dealItems           CrmDealItem[]
  commercialDocuments CrmCommercialDocument[]
  organizationId      String?
  organization        Organization?           @relation(fields: [organizationId], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, funnel])
  @@index([organizationId, pipelineId, pipelineStageId])
  @@index([bitrixLeadId])
  @@index([bitrixDealId])
  // Fecha a janela de corrida de duplicidade descrita no comentário de bitrixLeadId/bitrixDealId
  // acima: dois imports/exports concorrentes do MESMO registro Bitrix não conseguem mais criar
  // dois Leads locais (o segundo INSERT falha com violação de unique, tratada como "já
  // importado"/"já sincronizado" pelo chamador). NULL não colide com NULL em unique index do
  // Postgres — leads sem vínculo Bitrix continuam livres para existir aos milhares sem restrição.
  @@unique([organizationId, bitrixLeadId])
  @@unique([organizationId, bitrixDealId])
}

model Activity {
  id           String         @id @default(cuid())
  type         ActivityType
  owner        String
  date         DateTime
  time         String?
  status       ActivityStatus @default(Pendente)
  observations String?

  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  @@index([organizationId])
}

model TimelineEvent {
  id          String @id @default(cuid())
  type        String // creation, edition, movement, activity, comment, generic
  description String

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Note {
  id      String @id @default(cuid())
  content String // Rich text
  author  String

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  actorId   String?
  tenantId  String?
  ipAddress String?
  details   String?  @db.Text
  timestamp DateTime @default(now())

  @@index([tenantId, entity, action])
  @@index([actorId, timestamp])
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  // Better Auth guarda a senha em Account.password (provider "credential"), não aqui — este
  // campo é resquício de um fluxo de auth anterior e não é mais escrito por ninguém no app real.
  // Precisa ser opcional para não quebrar `prisma.user.create()` do adapter do Better Auth.
  passwordHash       String?
  role               String       @default("VISUALIZADOR")
  // Força a troca de senha no próximo login — usado quando um admin define uma senha
  // temporária/padrão pra outra pessoa (ver POST /api/auth-extra/change-password).
  mustChangePassword Boolean      @default(false)
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  emailVerified      Boolean      @default(false)
  image              String?
  sessions           Session[]
  accounts           Account[]

  @@index([organizationId])
  @@map("user")
}

model Organization {
  id                        String                     @id @default(cuid())
  name                      String                     @unique
  users                     User[]
  companies                 Company[]
  contacts                  Contact[]
  leads                     Lead[]
  prospects                 Prospect[]
  activities                Activity[]
  documents                 Document[]
  notifications             Notification[]
  automations               Automation[]
  aiLogs                    AILog[]
  aiPendingActions          AIPendingAction[]
  knowledgeChunks           KnowledgeChunk[]
  prompts                   Prompt[]
  agentMemories             AgentMemory[]
  callSuppressions          CallSuppression[]
  coldCallRuns              ColdCallRun[]
  whatsAppMessages          WhatsAppMessage[]
  conversationSignals       ConversationSignal[]
  googleWorkspaceConnection GoogleWorkspaceConnection?
  bitrixConnections         BitrixConnection[]
  bitrixSyncRules           BitrixSyncRule[]
  bitrixSyncLogs            BitrixSyncLog[]
  crmPipelines              CrmPipeline[]
  crmProducts               CrmProduct[]
  crmDealItems              CrmDealItem[]
  crmCommercialDocuments    CrmCommercialDocument[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
}

model CrmPipeline {
  id             String             @id @default(cuid())
  name           String
  entity         CrmPipelineEntity
  isDefault      Boolean            @default(false)
  active         Boolean            @default(true)
  sortOrder      Int                @default(0)
  currency       String             @default("BRL")
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages         CrmPipelineStage[]
  leads          Lead[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, entity, active])
}

model CrmPipelineStage {
  id                  String      @id @default(cuid())
  name                String
  code                String
  color               String      @default("#64748b")
  sortOrder           Int         @default(0)
  probability         Int         @default(0)
  leadStatus          LeadStatus?
  isWon               Boolean     @default(false)
  isLost              Boolean     @default(false)
  tunnelTargetStageId String?
  automation          Json?
  pipelineId          String
  pipeline            CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads               Lead[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([pipelineId, code])
  @@index([pipelineId, sortOrder])
}

model CrmProduct {
  id             String         @id @default(cuid())
  name           String
  description    String?
  sku            String?
  type           CrmProductType @default(Servico)
  category       String?
  unit           String         @default("un")
  price          Float
  cost           Float?
  currency       String         @default("BRL")
  taxPercent     Float          @default(0)
  active         Boolean        @default(true)
  stockQuantity  Float?
  customFields   Json?
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealItems      CrmDealItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId, active, name])
}

model CrmDealItem {
  id              String       @id @default(cuid())
  name            String
  sku             String?
  quantity        Float        @default(1)
  unitPrice       Float
  discountPercent Float        @default(0)
  taxPercent      Float        @default(0)
  total           Float
  sortOrder       Int          @default(0)
  leadId          String
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  productId       String?
  product         CrmProduct?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, leadId, sortOrder])
  @@index([productId])
}

model CrmCommercialDocument {
  id             String            @id @default(cuid())
  number         String
  type           CrmDocumentType
  status         CrmDocumentStatus @default(Rascunho)
  title          String
  currency       String            @default("BRL")
  issueDate      DateTime          @default(now())
  validUntil     DateTime?
  dueDate        DateTime?
  subtotal       Float             @default(0)
  discount       Float             @default(0)
  tax            Float             @default(0)
  total          Float             @default(0)
  lineItems      Json
  notes          String?
  terms          String?
  publicToken    String            @unique @default(uuid())
  leadId         String?
  lead           Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, type, status])
  @@index([leadId])
}

model KnowledgeChunk {
  id        String                      @id @default(cuid())
  content   String                      @db.Text
  // Metadados para filtrar por tenant, lead, etc. Mantido por compatibilidade; o isolamento real
  // de tenant passou a usar a coluna organizationId abaixo (RLS depende de uma coluna, não de JSON).
  metadata  Json?
  // Embedding gerado pelo modelo text-embedding (ex: Gemini/OpenAI), com 768 dimensões.
  embedding Unsupported("vector(768)")?

  // Nullable porque linhas legadas (inseridas antes desta coluna existir) não têm como ser
  // atribuídas com segurança a um tenant — ficam órfãs e, por design, invisíveis sob RLS.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Prompt {
  id        String   @id @default(cuid())
  name      String
  version   String
  owner     String
  category  String
  tags      String[]
  variables Json
  history   Json
  approved  Boolean  @default(false)

  // Nullable pelo mesmo motivo de KnowledgeChunk.organizationId: linhas legadas sem tenant
  // conhecido ficam órfãs e invisíveis sob RLS, em vez de serem apagadas ou expostas a todos.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, category])
}

model Document {
  id             String          @id @default(cuid())
  title          String
  metadata       Json?
  content        String
  chunks         DocumentChunk[]
  // Base de Conhecimento é por tenant: sem esta coluna qualquer organização leria os
  // documentos das outras (a RLS depende dela para filtrar).
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Origem do conteúdo, para a UI diferenciar upload de arquivo e texto colado.
  sourceType     String          @default("text")
  sourceName     String?
  // Contagem materializada: evita um COUNT por documento na listagem.
  chunkCount     Int             @default(0)
  createdBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, createdAt])
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  // Posição do trecho dentro do documento, para citar a origem no resultado da busca.
  chunkIndex Int                         @default(0)
  vector     Unsupported("vector(768)")?

  @@index([documentId])
}

model AgentMemory {
  id        String   @id @default(cuid())
  sessionId String
  agentType String
  messages  Json
  createdAt DateTime @default(now())

  // Nullable pelo mesmo motivo de KnowledgeChunk.organizationId: linhas legadas sem tenant
  // conhecido ficam órfãs e invisíveis sob RLS, em vez de serem apagadas ou expostas a todos.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([organizationId])
}

model AILog {
  id             String        @id @default(cuid())
  tokens         Int
  cost           Float
  latencyMs      Int
  model          String
  promptId       String?
  // Sem esta coluna não dá para dizer quanto CADA organização consumiu — é o que a tela de
  // Consumo precisa. Opcional porque os registros anteriores a ela não têm como ser atribuídos.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
}

/// Severidade da notificação — define o ícone e a cor de status na interface.
enum NotificationKind {
  Info
  Sucesso
  Alerta
  Erro
}

model Notification {
  id       String           @id @default(cuid())
  title    String
  body     String?
  kind     NotificationKind @default(Info)
  /// Entidade de origem, para a notificação poder levar o usuário ao lead/atividade que a gerou.
  entity   String?
  entityId String?
  readAt   DateTime?
  /// Destinatário específico; `null` significa "toda a organização".
  userId   String?

  /// Quando foi criada por uma automação, guarda qual — permite explicar a origem na interface.
  automationId String?
  automation   Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, readAt, createdAt])
}

/// Evento que dispara uma automação.
enum AutomationTrigger {
  Lead_Criado         @map("Lead criado")
  Lead_Mudou_Status   @map("Lead mudou de status")
  Atividade_Concluida @map("Atividade concluída")
}

/// O que a automação faz quando dispara.
enum AutomationAction {
  Notificar_Equipe @map("Notificar equipe")
  Criar_Atividade  @map("Criar atividade")
  Ligar_SDR_Voz    @map("Ligar via SDR de Voz")
}

model Automation {
  id      String  @id @default(cuid())
  name    String
  enabled Boolean @default(true)

  trigger    AutomationTrigger
  /// Filtro opcional do gatilho (ex: `{ "status": "Proposta" }`). Vazio = dispara sempre.
  conditions Json?

  action       AutomationAction
  /// Parâmetros da ação (ex: título da notificação, tipo/prazo da atividade a criar).
  actionConfig Json

  /// Telemetria de execução, para a tela mostrar se a regra está realmente rodando.
  lastRunAt DateTime?
  runCount  Int       @default(0)

  notifications Notification[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, enabled])
}

/// Lista interna de bloqueio de discagem: números para os quais o SDR de voz não pode ligar.
///
/// Existe porque o opt-out precisa valer no ato — quem pede "não me liguem mais" durante a ligação
/// não pode receber a próxima tentativa da campanha. Guardar o número já em E.164 é o que faz o
/// mesmo telefone cadastrado em formatos diferentes ("(11) 99999-8888", "011999998888") cair no
/// mesmo bloqueio, em vez de escapar por diferença de pontuação.
model CallSuppression {
  id String @id @default(cuid())

  /// Telefone normalizado em E.164 (`+5511999998888`) — é a chave real do bloqueio.
  phoneE164 String
  /// De onde veio o bloqueio: `call-opt-out` (pedido na própria ligação), `manual`, `import`.
  source    String
  /// Texto livre para auditoria (ex: trecho da transcrição em que o lead pediu para não ligar).
  reason    String?

  /// Lead em que o pedido aconteceu, quando houve um. Fica nulo em bloqueios importados de uma
  /// lista externa, e SET NULL na exclusão: apagar o lead não pode reabilitar a discagem.
  leadId String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// O bloqueio é por organização (cada tenant tem sua própria lista) e único por número, para o
  /// registro do opt-out ser idempotente — o webhook pode reentregar o mesmo evento.
  @@unique([organizationId, phoneE164])
  @@index([organizationId])
}

/// Mensagem trocada pelo WhatsApp (Baileys), enviada ou recebida. Sem esta tabela, mensagens
/// recebidas eram descartadas — o handler `messages.upsert` de whatsapp.service.ts só tinha um
/// comentário "// TODO: salvar no CRM no futuro". `contactId`/`leadId` ficam nulos quando o
/// número remetente não corresponde a nenhum contato já cadastrado no tenant.
model WhatsAppMessage {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Id da mensagem no WhatsApp — idempotência: o Baileys pode reentregar o mesmo evento após uma
  /// reconexão.
  waMessageId String
  direction   String // 'inbound' | 'outbound'
  /// Telefone normalizado em E.164 do lado remoto (quem mandou, se inbound; quem recebeu, se outbound).
  phoneE164   String
  body        String? @db.Text

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  receivedAt DateTime @default(now())

  @@unique([organizationId, waMessageId])
  @@index([organizationId, phoneE164])
  @@index([leadId])
}

/// Sinal de intenção extraído por IA de uma janela de mensagens de WhatsApp já persistidas em
/// `WhatsAppMessage` — não duplica o conteúdo da conversa, só o resultado estruturado da leitura
/// (ver `conversation-intelligence.service.ts`). Gerado por um worker assíncrono, nunca no caminho
/// de recebimento da mensagem.
model ConversationSignal {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Quantas mensagens da janela foram lidas nesta análise — só para auditoria, não é exibido como fato de negócio.
  messageCount Int

  intent          String? // ex: "alta_intencao_compra" | "duvida_tecnica" | "objecao_preco" | "sem_interesse" | "neutro"
  urgency         String? // "alta" | "media" | "baixa"
  objections      String[]
  budgetMentioned Boolean  @default(false)
  nextStep        String?  @db.Text
  summary         String?  @db.Text
  /// Confiança do próprio modelo na classificação (0-1), quando ele reporta — usado para não tratar
  /// leituras incertas como se fossem fato.
  confidence      Float?

  /// JSON bruto devolvido pelo modelo — auditoria/depuração, o mesmo espírito do `rawData` em `EnrichmentLog`.
  rawModelOutput Json?

  createdAt DateTime @default(now())

  @@index([organizationId, leadId, createdAt])
}

/// Conexão real de Google Workspace (Gmail + Calendar) de uma organização — antes disso,
/// google.service.ts era inteiramente simulado (`access_token: 'mock_token'`), sem persistir nada.
/// Um registro por organização: é a integração do tenant, não de um usuário individual.
model GoogleWorkspaceConnection {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Conta Google conectada — mostrado na tela de Integrações.
  email        String
  /// Cifrados em repouso (AES-256-GCM) de forma transparente pela extensão Prisma em
  /// src/lib/prisma.ts — ver src/lib/crypto/secretFields.ts.
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  scope        String
  expiresAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Conexão do Bitrix24 de uma organização — webhook de entrada gerado pelo próprio usuário no
/// portal Bitrix24 dele (Aplicativos > Webhooks > Webhook de entrada, escopo "crm"). Antes disso
/// a URL do webhook não era persistida em lugar nenhum: cada exportação exigia colar a URL de
/// novo no corpo da requisição, e não havia nenhuma tela para configurá-la. Um registro por
/// organização, igual ao padrão do GoogleWorkspaceConnection acima.
/// Uma organização Atlas pode falar com MAIS DE UM portal Bitrix24 ao mesmo tempo (ex.: AtlasGR e
/// TotalTrac são marcas/empresas distintas, cada uma com seu próprio Bitrix) — por isso não é mais
/// 1:1 com Organization (era @unique antes; várias linhas por organizationId agora são o normal).
/// Cada conexão é independente: sua própria importação seletiva, seus próprios pipelines/etapas,
/// suas próprias regras de sincronização automática (ver BitrixSyncRule.connectionId).
model BitrixConnection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Nome de exibição pra distinguir as conexões na tela (ex.: "AtlasGR", "TotalTrac") — livre,
  /// não precisa bater com o domínio real do portal.
  label String @default("Bitrix24")

  /// URL completa do webhook de entrada, incluindo o token (ex: https://SEUDOMINIO.bitrix24.com.br/rest/1/xxxxxxxx/).
  /// Cifrada em repouso (AES-256-GCM) de forma transparente pela extensão Prisma em
  /// src/lib/prisma.ts — ver src/lib/crypto/secretFields.ts. A coluna em si continua `Text` porque
  /// o valor cifrado (formato "enc:v1:...") é mais longo que a URL original; a proteção de tenant
  /// via RLS permanece como camada adicional, não substituída por isto.
  webhookUrl String @db.Text

  /// Checkpoint da última importação bem-sucedida (crm.lead.list filtrado por >DATE_MODIFY a
  /// partir daqui) — sem isto, cada rodada do worker periódico teria que reprocessar os leads
  /// inteiros do portal a cada 15 minutos em vez de só o que mudou.
  lastImportedAt DateTime?

  /// Segredo do webhook de SAÍDA do Bitrix ("исходящий вебхук") que este portal chama de volta —
  /// gerado pelo Atlas, colado pela pessoa no cadastro do webhook de saída no admin do Bitrix.
  /// Comparado contra `auth.application_token` de cada evento recebido (ver bitrix.webhook.ts)
  /// antes de aceitar qualquer payload — sem isto, a rota seria um endpoint público aceitando
  /// qualquer POST. Cifrado em repouso do mesmo jeito que webhookUrl (ver ENCRYPTED_FIELDS em
  /// src/lib/prisma.ts).
  webhookSecret String? @db.Text
  /// Só processa eventos de entrada (ONCRMLEADUPDATE etc.) quando true — desligado por padrão:
  /// gerar o segredo não é o mesmo que já ter colado a URL no Bitrix, e aceitar eventos de um
  /// webhook de saída ainda não configurado lá não tem como acontecer de verdade, mas o flag
  /// deixa a intenção explícita em vez de inferir do segredo existir ou não.
  inboundEventsEnabled Boolean @default(false)

  syncRules BitrixSyncRule[]
  syncLogs  BitrixSyncLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

/// Regra de sincronização automática Bitrix → Atlas (ver bitrixSync.worker.ts). Diferente da
/// importação manual (listBitrixLeads/listBitrixDeals, sempre por escolha explícita na tela),
/// isto é opt-in por regra: só existe automação para o que o usuário definiu aqui, escopado por
/// pipeline/etapa/vendedor — nunca "importar tudo que aparecer", que encheria o CRM de lixo (o
/// portal mistura prospecção real com notificações de e-mail automáticas, chamados de suporte
/// etc.). Sem nenhuma regra ativa, o worker não faz nada.
model BitrixSyncRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Qual conexão/portal Bitrix esta regra observa — uma organização pode ter mais de uma
  /// conexão (ex.: AtlasGR e TotalTrac), então a regra precisa dizer qual delas, não só o tenant.
  connectionId String
  connection   BitrixConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  /// "deal" (objeto Negócio, com pipeline/etapa reais) ou "lead" (objeto Lead, lista plana de
  /// status — sem pipeline). Portais diferentes usam um, outro, ou os dois em paralelo.
  source String @default("deal")

  /// CATEGORY_ID do pipeline de Negócio a observar (ex: "28" = Comercial) — obrigatório quando
  /// source="deal", ignorado quando source="lead" (Lead não tem pipeline).
  categoryId   String?
  /// STAGE_ID (Deal) ou STATUS_ID (Lead) opcional — sem isso, a regra observa todas as etapas/status.
  stageId      String?
  /// ASSIGNED_BY_ID opcional — sem isso, a regra observa registros de qualquer vendedor.
  assignedById String?

  active Boolean @default(true)

  lastRunAt         DateTime?
  lastImportedCount Int       @default(0)
  /// Mensagem da última falha de execução (null se a última tentativa teve sucesso) — fecha a
  /// lacuna descrita no comentário de runBitrixSyncTick: antes disso o schema não tinha onde
  /// guardar POR QUE uma regra estava falhando, só QUANDO ela tentou pela última vez.
  lastError String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([connectionId])
  @@index([active])
}

/// Trilha de auditoria por operação de sincronização Bitrix (import, export, push automático,
/// evento de webhook de entrada) — granularidade que BitrixSyncRule.lastRunAt/lastImportedCount
/// não tem (só o resumo da última rodada de UMA regra). Responde "este lead foi realmente
/// enviado/recebido do Bitrix, quando, e com que resultado?" por registro, não só por regra.
model BitrixSyncLog {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId   String?
  connection     BitrixConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  /// 'inbound' (Bitrix → Atlas: import manual, regra automática, webhook) ou 'outbound' (Atlas → Bitrix).
  direction String
  /// 'lead' ou 'deal' — qual objeto Bitrix esta operação tocou.
  entityType String
  /// Lead local afetado, quando existe (pode ser null num evento de webhook para um Bitrix ID
  /// ainda não importado — a operação é só ignorada, mas fica registrada mesmo assim).
  leadId String?
  /// ID do registro no Bitrix (Lead ou Deal, conforme entityType).
  bitrixRecordId String?

  /// 'success' | 'failed' | 'skipped'
  status       String
  errorMessage String? @db.Text
  /// Mesmo correlationId usado nos logs estruturados (client.ts/outboundSync.ts) — permite achar
  /// a chamada HTTP exata que gerou esta linha nos logs da aplicação.
  correlationId String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([leadId])
  @@index([connectionId, createdAt])
}

/// Um registro por execução da campanha de prospecção fria (ver coldCall.service.ts). Sem isto a
/// campanha rodava 100% invisível — só `logger.info`, sem nenhuma tela para a operação ver o que
/// o SDR de voz fez (quantos discou, quantos pulou e por quê).
model ColdCallRun {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  scanned            Int
  called             Int
  skippedMaxAttempts Int     @default(0)
  skippedCooldown    Int     @default(0)
  skippedNoPhone     Int     @default(0)
  skippedSuppressed  Int     @default(0)
  skippedError       Int     @default(0)
  /// Preenchido quando a execução nem chegou a examinar leads (ex: fora da janela de discagem).
  haltedBy           String?

  runAt DateTime @default(now())

  @@index([organizationId, runAt])
}

model AIGovernancePolicy {
  id       String @id @default(cuid())
  name     String
  rules    Json
  tenantId String
}

model AIEvaluation {
  id                 String @id @default(cuid())
  logId              String
  precisionScore     Float
  hallucinationScore Float
}

model AIPendingAction {
  id             String        @id @default(cuid())
  entity         String
  action         String
  payload        Json
  /// Papel que originou a decisão (SDR, BDR, CLOSER, CRM, OPS ou SUPERVISOR).
  agentRole      String?
  /// Classificação de risco operacional para a UI e para políticas de autoexecução.
  riskLevel      String        @default("medium")
  /// Confiança declarada/derivada da decisão, normalizada entre 0 e 1.
  confidence     Float?
  /// Chave de idempotência por tenant. Impede que um worker repetido proponha/envie a mesma ação.
  idempotencyKey String?
  approved       Boolean       @default(false)
  approvedAt     DateTime?
  discardedAt    DateTime?
  /// Se a ação aprovada foi de fato executada (ex: e-mail enviado de verdade via SMTP). Sem este
  /// campo, "aprovar" só marcava um flag no banco e nada consumia isso depois (IA-005) — o
  /// executor real fica em src/features/intelligence/services/aiPendingAction.service.ts.
  executed       Boolean       @default(false)
  executedAt     DateTime?
  /// Preenchido quando a execução foi tentada e falhou (ex: SMTP fora do ar). `executed`
  /// continua false nesse caso — a tela usa isso para decidir se ainda oferece o fallback manual.
  executionError String?
  attempts       Int           @default(0)
  lastAttemptAt  DateTime?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, approved])
  @@index([organizationId, discardedAt, approved, createdAt], map: "AIPendingAction_autonomy_queue_idx")
}

/// Modelo/provedor de IA escolhido para cada ferramenta (toolKey = chave em ContentTool, ex.
/// "script_call", "risk"), editável pela tela AIConfigCenter. Quando não há registro para uma
/// ferramenta, o serviço cai no TOOL_CONFIG hardcoded como padrão.
model AiEngineSetting {
  id          String   @id @default(cuid())
  toolKey     String   @unique
  provider    String
  model       String
  temperature Float
  updatedAt   DateTime @updatedAt
}

// ==========================================
// AtlasGR Prospect - Motor de Prospecção
// ==========================================

model Prospect {
  id              String  @id @default(cuid())
  cnpj            String? @unique
  companyName     String
  fantasyName     String?
  confidenceScore Int     @default(0)

  // Dados Brutos e Enriquecidos
  enrichedData Json?
  intelligence Json? // SWOT, BANT, Objeções
  leadScore    Int?

  status   String  @default("NEW") // NEW, ENRICHING, READY, EXPORTED
  bitrixId String?

  // Controle de Tenant
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}
