model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  // Better Auth guarda a senha em Account.password (provider "credential"), não aqui — este
  // campo é resquício de um fluxo de auth anterior e não é mais escrito por ninguém no app real.
  // Precisa ser opcional para não quebrar `prisma.user.create()` do adapter do Better Auth.
  passwordHash       String?
  role               UserRole     @default(VISUALIZADOR)
  bitrixUserId       Int?
  // Força a troca de senha no próximo login — usado quando um admin define uma senha
  // temporária/padrão pra outra pessoa (ver POST /api/auth-extra/change-password).
  mustChangePassword Boolean      @default(false)
  // Bloqueio de conta por tentativas de login malsucedidas (ver hooks.before/after em
  // src/lib/auth.ts) — complementa o rate limit por IP (src/bootstrap/rateLimiters.ts,
  // AUTH_RATE_LIMIT_MAX) com um limite por CONTA: um atacante distribuído por vários IPs contra a
  // MESMA conta ainda é contido, o que o rate limit por IP sozinho não cobre.
  failedLoginAttempts Int         @default(0)
  lockedUntil         DateTime?
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  emailVerified      Boolean      @default(false)
  image              String?
  sessions           Session[]
  accounts           Account[]
  assistantMessages  AssistantMessage[]
  publicBookingLinks PublicBookingLink[]

  @@index([organizationId])
  @@map("user")
}

