  users                         User[]
  companies                     Company[]
  contacts                      Contact[]
  leads                         Lead[]
  prospects                     Prospect[]
  activities                    Activity[]
  documents                     Document[]
  notifications                 Notification[]
  automations                   Automation[]
  aiLogs                        AILog[]
  aiGuardrailEvents             AIGuardrailEvent[]
  reports                       Report[]
  assistantMessages             AssistantMessage[]
  qualificationMatrixItems      QualificationMatrixItem[]
  objectionMatrixItems          ObjectionMatrixItem[]
  aiPendingActions              AIPendingAction[]

  prompts                       Prompt[]
  agentMemories                 AgentMemory[]
  callSuppressions              CallSuppression[]
  coldCallRuns                  ColdCallRun[]
  whatsAppMessages              WhatsAppMessage[]
  conversationSignals           ConversationSignal[]
  googleWorkspaceConnection     GoogleWorkspaceConnection?
  bitrixConnections             BitrixConnection[]
  bitrixSyncRules               BitrixSyncRule[]
  bitrixSyncLogs                BitrixSyncLog[]
  bitrixExtractionRuns          BitrixExtractionRun[]
  threeCXConnections            ThreeCXConnection[]
  optOutRecords                 OptOutRecord[]
  crmPipelines                  CrmPipeline[]
  crmProducts                   CrmProduct[]
  crmDealItems                  CrmDealItem[]
  crmCommercialDocuments        CrmCommercialDocument[]
  commercialGoals               CommercialGoal[]
  leadStageHistories            LeadStageHistory[]
  forecastSnapshots             ForecastSnapshot[]
  leadFieldChanges              LeadFieldChange[]
  featureFlagOverrides          OrganizationFeatureFlag[]
  bugReports                    BugReport[]
  // Onda 10 (Agente 01A) — schema de cadência/agendamento/proposta-assinatura proposto pelo
  // Agente 17 em .agents/handoffs/onda-7/17-para-01-schema-cadencia-optout-proposta.md (itens 2-5;
  // item 1, OptOutRecord acima, já estava em produção).
  cadenceSequences              CadenceSequence[]
  cadenceRuns                   CadenceRun[]
  cadenceTouchAttempts          CadenceTouchAttempt[]
  emailMessages                 EmailMessage[]
  cadenceCalendarEvents         CadenceCalendarEvent[]
  crmCommercialDocumentVersions CrmCommercialDocumentVersion[]
  crmDocumentSignatureRequests  CrmDocumentSignatureRequest[]
  dealClosureEvents             DealClosureEvent[]
  prospectRejections            ProspectRejection[]
  accountIntelligenceSnapshots  AccountIntelligenceSnapshot[]
  accountSignals                AccountSignal[]
  decisionMakers                DecisionMaker[]
  intelligenceEvidence          IntelligenceEvidence[]
  accountScores                 AccountScore[]
  accountRecommendations        AccountRecommendation[]
  economicRelationships         EconomicRelationship[]
