// ─── Comercial Inteligente (Revenue Command Center) ────────────────────────
// Extensão mínima de schema pedida pelo módulo executivo restrito (Gestor/Diretor/CEO — ver
// canAccessCommercialIntelligence em src/lib/auth/authorization.ts). Duas tabelas novas, as
// únicas que o módulo genuinamente não conseguia calcular a partir do schema já existente:
//
// 1. CommercialGoal — não existia NENHUM model de meta/quota comercial no schema. Sem isso,
//    "% da Meta"/Gap Forecast/Coverage teriam que fabricar um número, o que a seção 40 do prompt
//    de produto e o AGENTS.md ("Dados reais x demonstração") proíbem explicitamente. A meta é
//    sempre um valor real digitado por um Gestor/Admin (ver commercialGoal.routes), nunca
//    inferido.
// 2. LeadStageHistory — não existia histórico estruturado de mudança de etapa (TimelineEvent é
//    texto livre, sem fromStage/toStage/enteredAt/exitedAt consultável). Sem isso, Aging por
//    Etapa e Sales Cycle por etapa não são calculáveis de forma real (ver seção 34 do prompt:
//    "não inventar histórico inexistente" — a extensão mínima de schema é o caminho permitido).
//    Alimentada a partir de agora em diante pelos mesmos pontos de escrita que já movem uma
//    oportunidade de etapa (crm360.service.ts moveRecord/createDeal/convertLead) — ver
//    src/features/commercial-intelligence/infra/stageHistory.ts. Leads que mudaram de etapa
//    ANTES desta migration não têm histórico real: os endpoints tratam isso como dado ausente
//    ("Não disponível"/estimado, nunca um valor calculado a partir de histórico fabricado).
model CommercialGoal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Formato "YYYY-MM" — mesma granularidade mensal usada em toda a Meta New MRR do prompt de
  // produto (seção 7). Metas trimestrais/anuais são derivadas somando meses, não um registro à parte.
  period         String
  // Hoje só "NEW_MRR" é usado pela UI, mas o campo já existe para não exigir outra migration
  // quando o módulo ganhar metas por métrica (ex.: pipeline criado) no futuro.
  metric         String       @default("NEW_MRR")
  amount         Float
  currency       String       @default("BRL")
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, period, metric])
  @@index([organizationId, period])
}

model LeadStageHistory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // pipelineId/stageId ficam nullable e stageName é desnormalizado de propósito: uma etapa pode
  // ser reordenada/excluída depois, e o histórico não pode virar órfão nem mudar de sentido
  // retroativamente por causa disso — o nome no momento da transição é preservado como registrado.
  pipelineId     String?
  stageId        String?
  stageName      String
  probability    Int?
  isWon          Boolean      @default(false)
  isLost         Boolean      @default(false)
  // Nula enquanto a oportunidade permanece nesta etapa; setada quando ela sai (para a próxima
  // etapa ou fechamento). A linha com exitedAt=null é sempre a etapa atual do lead.
  enteredAt      DateTime     @default(now())
  exitedAt       DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, leadId, enteredAt])
  @@index([organizationId, stageId])
  @@index([leadId, exitedAt])
}

// Onda 39 (Agente 04, handoff .agents/handoffs/onda-39/04-para-01-schema-forecast-snapshot.md):
// snapshot semanal append-only do Forecast (Commit/Best Case/Forecast por categoria + versão das
// regras que o gerou), necessário para o erro histórico real (previsto x realizado) do Health
// Score de Forecast — sem persistência, esse pilar nunca tem um snapshot antigo pra comparar
// contra o realizado e fica permanentemente "não disponível" em produção. Nunca sobrescrito nem
// truncado: cada corrida do snapshot semanal insere uma linha nova, mesmo período incluído
// (histórico de revisões), nunca um upsert por período.
model ForecastSnapshot {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Período (mês) que este snapshot está prevendo — "YYYY-MM", mesma granularidade de CommercialGoal.
  period         String
  snapshotAt     DateTime     @default(now())
  rulesVersion   String
  commitAmount   Decimal      @db.Decimal(14, 2)
  bestCaseAmount Decimal      @db.Decimal(14, 2)
  forecastAmount Decimal      @db.Decimal(14, 2)
  currency       String       @default("BRL")

  @@index([organizationId, period])
  @@index([organizationId, period, snapshotAt])
}

// Histórico estruturado de mudança de CAMPO de uma oportunidade (não de etapa — isso é
// LeadStageHistory). Hoje rastreia dois campos que alimentam inteligência executiva e que, antes
// desta tabela, não tinham NENHUM histórico consultável (TimelineEvent é texto livre):
//   - `expectedCloseAt` → CLOSEDATE Intelligence (adiamentos/antecipações, dias deslocados,
//     oportunidades constantemente empurradas — src/features/commercial-intelligence/application/
//     queries/closeDateIntelligenceReport.ts);
//   - `owner` → Handoffs/trocas de responsável (queries/journeyReport.ts).
// Append-only, gravado pelo helper único src/shared/services/leadFieldChangeHistory.service.ts nos mesmos pontos de escrita
// reais que já alteram esses campos. Histórico anterior à migration não existe e os relatórios
// tratam isso como "sem histórico" (trackingSince), nunca fabricado.
model LeadFieldChange {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// Nome do campo de Lead alterado ("expectedCloseAt" | "owner").
  field          String
  /// Valores serializados como texto (ISO 8601 para datas, id/nome para owner). Null = campo estava/ficou vazio.
  previousValue  String?
  newValue       String?
  /// Quem mudou (User.id) quando conhecido; null em escrita por integração/automação.
  changedBy      String?
  /// Origem da escrita: "crm" | "crm360" | "batch" | "round_robin" — rastreabilidade, não regra.
  source         String       @default("crm")
  changedAt      DateTime     @default(now())

  @@index([organizationId, field, changedAt])
  @@index([organizationId, leadId, field])
  @@index([leadId, changedAt])
}

// ─── LDR / Account Intelligence ────────────────────────────────────────────
// Esta fundacao estende a Company real do CRM; nao cria uma segunda entidade de empresa, contato
// ou lead. Todas as tabelas sao por organizationId, usam RLS e mantem historico/evidencia em vez de
// sobrescrever a explicacao que produziu um score ou uma recomendacao.

/// Fotografia versionada da inteligencia conhecida sobre uma Company em um instante. `sourceStatus`
/// registra sucesso/falha por fonte para que uma integracao indisponivel nao apague fatos validos
/// das demais. `structuredFacts` contem somente fatos normalizados, nunca segredo/payload bruto.
model AccountIntelligenceSnapshot {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  version         Int
  generatedAt     DateTime                   @default(now())
  expiresAt       DateTime?
  summary         String                     @db.Text
  structuredFacts Json
  sourceStatus    Json
  status          IntelligenceSnapshotStatus @default(Partial)
  createdAt       DateTime                   @default(now())

  signals         AccountSignal[]
  decisionMakers  DecisionMaker[]
  evidence        IntelligenceEvidence[]
  scores          AccountScore[]
  recommendations AccountRecommendation[]
  relationships   EconomicRelationship[]

  @@unique([organizationId, companyId, version])
  @@unique([id, organizationId, companyId])
  @@index([organizationId, companyId, generatedAt(sort: Desc)])
  @@index([organizationId, companyId, status])
  @@index([organizationId, expiresAt])
}

/// Sinal comercial deduplicavel por conta. Reobservacoes atualizam lastSeenAt/occurrenceCount em
/// vez de gerar varias acoes para o mesmo evento. A taxonomia e versionada separadamente do tipo.
model AccountSignal {
  id             String                       @id @default(cuid())
  organizationId String
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company                      @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  snapshotId     String?
  snapshot       AccountIntelligenceSnapshot? @relation(fields: [snapshotId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)

  type            String
  taxonomyVersion String
  title           String
  description     String                   @db.Text
  detectedAt      DateTime                 @default(now())
  effectiveAt     DateTime?
  source          String
  sourceUrl       String?
  confidence      Float
  evidenceType    IntelligenceEvidenceType
  status          AccountSignalStatus      @default(Active)
  dedupeKey       String
  firstSeenAt     DateTime                 @default(now())
  lastSeenAt      DateTime                 @default(now())
  occurrenceCount Int                      @default(1)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([organizationId, companyId, dedupeKey])
  @@index([organizationId, companyId, detectedAt(sort: Desc)])
  @@index([organizationId, companyId, type, status])
  @@index([organizationId, status, lastSeenAt(sort: Desc)])
  @@index([snapshotId])
}

/// Metadados de buying committee sobre um Contact ja existente. Nome, cargo, telefone e e-mail
/// permanecem exclusivamente em Contact: esta tabela so guarda classificacao, fonte e confianca.
/// A FK composta prova que Contact, Company e organizationId pertencem ao mesmo tenant.
model DecisionMaker {
  id             String                       @id @default(cuid())
  organizationId String
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company                      @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  contactId      String
  contact        Contact                      @relation(fields: [contactId, companyId, organizationId], references: [id, companyId, organizationId], onDelete: Cascade)
  snapshotId     String?
  snapshot       AccountIntelligenceSnapshot? @relation(fields: [snapshotId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)

  buyingRole       String
  department       String?
  seniority        String?
  roleEvidenceType IntelligenceEvidenceType
  source           String
  sourceUrl        String?
  verifiedAt       DateTime?
  confidence       Float
  status           DecisionMakerStatus      @default(Unverified)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([organizationId, companyId, contactId])
  @@index([organizationId, companyId, status])
  @@index([organizationId, companyId, buyingRole])
  @@index([snapshotId])
}

/// Evidencia normalizada e deduplicavel. subjectType/subjectId permitem vincular a um signal,
/// score, decisor, relacionamento ou recomendacao sem armazenar payload bruto de fornecedor.
/// `evidenceType` torna FATO/INFERENCIA/RECOMENDACAO uma propriedade consultavel, nao um rotulo UI.
model IntelligenceEvidence {
  id             String                       @id @default(cuid())
  organizationId String
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company                      @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  snapshotId     String?
  snapshot       AccountIntelligenceSnapshot? @relation(fields: [snapshotId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)

  subjectType  String
  subjectId    String?
  factKey      String
  value        Json?
  valueHash    String?
  reference    String?
  source       String
  sourceUrl    String?
  collectedAt  DateTime                 @default(now())
  confidence   Float?
  evidenceType IntelligenceEvidenceType
  dedupeKey    String
  createdAt    DateTime                 @default(now())

  @@unique([organizationId, companyId, dedupeKey])
  @@index([organizationId, companyId, collectedAt(sort: Desc)])
  @@index([organizationId, companyId, evidenceType])
  @@index([organizationId, subjectType, subjectId])
  @@index([snapshotId])
}

/// Historico append-only de score. O hash de entrada + versao torna repeticoes idempotentes;
/// `calculation` preserva pesos/contribuicoes e os reasons positivos/negativos explicam o total.
model AccountScore {
  id             String                      @id @default(cuid())
  organizationId String
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company                     @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  snapshotId     String
  snapshot       AccountIntelligenceSnapshot @relation(fields: [snapshotId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)

  total           Int
  fit             Int
  timing          Int
  intent          Int
  relationship    Int
  positiveReasons String[]
  negativeReasons String[]
  calculation     Json
  scoreVersion    String
  inputHash       String
  calculatedAt    DateTime @default(now())
  createdAt       DateTime @default(now())

  recommendations AccountRecommendation[]

  @@unique([organizationId, companyId, scoreVersion, inputHash])
  @@unique([id, organizationId, companyId])
  @@index([organizationId, companyId, calculatedAt(sort: Desc)])
  @@index([organizationId, total(sort: Desc), calculatedAt(sort: Desc)])
  @@index([snapshotId])
}

/// Next Best Action auditavel: guarda a versao/entrada que a gerou, revisao humana, execucao e
/// referencia externa. O rationale permanece historico, mesmo quando a recomendacao e superada.
model AccountRecommendation {
  id             String                      @id @default(cuid())
  organizationId String
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company                     @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  snapshotId     String
  snapshot       AccountIntelligenceSnapshot @relation(fields: [snapshotId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  accountScoreId String?
  accountScore   AccountScore?               @relation(fields: [accountScoreId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)

  actionType            String
  title                 String
  rationale             String                      @db.Text
  priority              Int
  expectedImpact        String?                     @db.Text
  status                AccountRecommendationStatus @default(Pending)
  recommendationVersion String
  inputHash             String
  generatedBy           String
  generatedAt           DateTime                    @default(now())
  reviewedAt            DateTime?
  reviewedBy            String?
  executedAt            DateTime?
  externalRef           String?
  idempotencyKey        String?
  statusReason          String?                     @db.Text
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@unique([organizationId, companyId, actionType, inputHash])
  // Unicidade quando preenchida e garantida por indice parcial na migration; indice parcial nao
  // e representavel na DSL do Prisma e por isso nao aparece como @@unique aqui.
  @@index([organizationId, companyId, status, generatedAt(sort: Desc)])
  @@index([organizationId, status, priority])
  @@index([snapshotId])
  @@index([accountScoreId])
}

/// Relacao economica entre duas Companies reais do mesmo tenant. `Verified` e `Inferred` sao
/// estados distintos; uma inferencia nunca vira automaticamente uma relacao verificada.
model EconomicRelationship {
  id              String                       @id @default(cuid())
  organizationId  String
  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceCompanyId String
  sourceCompany   Company                      @relation("EconomicRelationshipSource", fields: [sourceCompanyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  targetCompanyId String
  targetCompany   Company                      @relation("EconomicRelationshipTarget", fields: [targetCompanyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  snapshotId      String?
  snapshot        AccountIntelligenceSnapshot? @relation(fields: [snapshotId, organizationId, sourceCompanyId], references: [id, organizationId, companyId], onDelete: Restrict)

  relationType String
  status       EconomicRelationshipStatus @default(Inferred)
  source       String
  sourceUrl    String?
  confidence   Float
  dedupeKey    String
  detectedAt   DateTime                   @default(now())
  verifiedAt   DateTime?
  validFrom    DateTime?
  validTo      DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, sourceCompanyId, status])
  @@index([organizationId, targetCompanyId, status])
  @@index([organizationId, relationType, detectedAt(sort: Desc)])
  @@index([snapshotId])
}

