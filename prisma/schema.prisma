  id                            String                       @id
  datasetId                     String
  dataset                       MarketIntelligenceDataset    @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  cnpj                          String
  cnpjBasico                    String
  cnpjOrdem                     String
  cnpjDv                        String
  razaoSocial                   String
  razaoSocialSearch             String
  nomeFantasia                  String?
  nomeFantasiaSearch            String?
  matrizFilial                  String?
  situacaoCadastralCodigo       String?
  situacaoCadastral             String?
  dataSituacaoCadastral         DateTime?                    @db.Date
  motivoSituacaoCodigo          String?
  motivoSituacaoCadastral       String?
  dataInicioAtividade           DateTime?                    @db.Date
  cnaePrincipal                 String?
  cnaePrincipalDescricao        String?
  cnaesSecundarios              Json?
  naturezaJuridicaCodigo        String?
  naturezaJuridica              String?
  porteCodigo                   String?
  porte                         String?
  capitalSocial                 Decimal?                     @db.Decimal(20, 2)
  qualificacaoResponsavelCodigo String?
  qualificacaoResponsavel       String?
  enteFederativoResponsavel     String?
  opcaoSimples                  String?
  dataOpcaoSimples              DateTime?                    @db.Date
  dataExclusaoSimples           DateTime?                    @db.Date
  opcaoMei                      String?
  dataOpcaoMei                  DateTime?                    @db.Date
  dataExclusaoMei               DateTime?                    @db.Date
  tipoLogradouro                String?
  logradouro                    String?
  numero                        String?
  complemento                   String?
  bairro                        String?
  cep                           String?
  municipioCodigoReceita        String?
  municipioIbge                 String?
  municipioNome                 String?
  municipioNomeSearch           String?
  uf                            String?
  ddd1                          String?
  telefone1                     String?
  ddd2                          String?
  telefone2                     String?
  dddFax                        String?
