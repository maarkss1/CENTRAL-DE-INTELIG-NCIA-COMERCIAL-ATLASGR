model Document {
  id             String          @id @default(cuid())
  title          String
  metadata       Json?
  content        String
  chunks         DocumentChunk[]
  // Base de Conhecimento é por tenant: sem esta coluna qualquer organização leria os
  // documentos das outras (a RLS depende dela para filtrar).
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Origem do conteúdo, para a UI diferenciar upload de arquivo e texto colado.
  sourceType     String          @default("text")
  sourceName     String?
  // Contagem materializada: evita um COUNT por documento na listagem.
  chunkCount     Int             @default(0)
  // Onda 40 (auditoria CPI — "RAG: document version/freshness ausente"): incrementado só quando o
  // CONTEÚDO é reindexado (ingestion.service.ts updateDocument, ramo contentChanged) — editar só o
  // título não conta como nova versão. Sem histórico de versões anteriores (reindexação continua
  // in-place, chunks antigos são apagados), mas já permite saber se um documento retornado por uma
  // busca é a versão mais recente indexada ou uma referência potencialmente desatualizada.
  version        Int             @default(1)
  createdBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, createdAt])
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  // Posição do trecho dentro do documento, para citar a origem no resultado da busca.
  chunkIndex Int                         @default(0)
  vector     Unsupported("vector(768)")?

  @@index([documentId])
}

// AI-003 (onda 31): uma linha por (sessionId, agentType, organizationId) representando o estado
// MAIS RECENTE dessa sessão — nunca um histórico de linhas por turno. `status`/`errorMessage`
// tornam uma falha de execução (bloqueio de LGPD, erro no grafo, erro de persistência) um estado
// explícito e consultável, não silêncio: antes, "nenhuma linha" significava indistintamente "ainda
// rodando" e "falhou antes de gravar nada", e a única leitura que checava isso
// (GET /agents/sdr/status/:sessionId) tratava os dois casos como "pending" para sempre.
model AgentMemory {
  id           String            @id @default(cuid())
  sessionId    String
  agentType    String
  messages     Json
  status       AgentMemoryStatus @default(Completed)
  // Preenchido só quando status = Failed; motivo sanitizado/truncado da falha (guardrail de LGPD,
  // erro do grafo LangGraph, ou erro genuíno de escrita), nunca o stack trace inteiro.
  errorMessage String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Nullable pelo mesmo motivo de KnowledgeChunk.organizationId: linhas legadas sem tenant
  // conhecido ficam órfãs e invisíveis sob RLS, em vez de serem apagadas ou expostas a todos. Como
  // organizationId nulo nunca colide num índice único do Postgres (NULL != NULL), essas linhas
  // legadas ficam fora da proteção do @@unique abaixo — aceitável porque nenhum caminho de escrita
  // ativo grava organizationId nulo hoje (todos resolvem o tenant via requestContext/parâmetro
  // explícito antes de chamar upsertAgentMemory).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Substitui o padrão anterior (findFirst por sessionId+organizationId, sem agentType, seguido de
  // create/update condicional) por um upsert atômico real — o padrão antigo tinha uma janela de
  // corrida real: duas chamadas concorrentes com o mesmo sessionId podiam ambas ver "não existe" e
  // ambas criar uma linha, duplicando o registro (ver upsertAgentMemory em agentMemory.store.ts).
  @@unique([sessionId, agentType, organizationId])
  @@index([organizationId])
}

enum AgentMemoryStatus {
  Completed
  Failed
}

model AILog {
  id             String        @id @default(cuid())
  tokens         Int
  cost           Float
  latencyMs      Int
  model          String
  promptId       String?
  // Sem esta coluna não dá para dizer quanto CADA organização consumiu — é o que a tela de
  // Consumo precisa. Opcional porque os registros anteriores a ela não têm como ser atribuídos.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
}

/// AI-006 (onda 35): sinal real de vazamento de PII detectado/mascarado pelo guardrail de saída
/// (`redactSensitiveData`, guardrails.service.ts) antes de uma resposta de IA chegar ao usuário —
/// alimenta a dimensão "PII leakage rate" do harness de avaliação (evaluationMetrics.service.ts).
/// Diferente de `AILog`, sempre escrito de dentro de uma requisição autenticada (os 4 pontos de
/// chamada de `redactSensitiveData` em produção são rotas atrás de `authenticateToken` +
/// `requireTenant`), então `organizationId` é sempre conhecido — sem o caso nulo que `AILog`
/// precisa tratar para chamadas de worker/script sem tenant.
model AIGuardrailEvent {
  id     String @id @default(cuid())
  /// Hoje só existe um valor real: 'pii_redacted'. String (não enum) de propósito — o conjunto de
  /// tipos de evento de guardrail ainda pode crescer (ex.: um futuro detector de prompt injection),
  /// e adicionar um valor a um enum do Postgres exige sua própria migration; um novo `type` aqui
  /// não exige.
  type   String
  /// Qual ponto de chamada registrou o evento (`ai.service`, `studio`, `agent.chat`,
  /// `commercial-intelligence`) — para localizar o fluxo real sem abrir os logs de aplicação.
  source String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, type, createdAt])
}

/// Relatório executivo gerado por IA em ReportsHub (POST /api/intelligence/report) a partir das
/// métricas ao vivo da plataforma. Antes desta correção (PC-008) o relatório só existia em estado
/// local do React — sumia ao navegar ou recarregar. `metrics` guarda o snapshot usado para gerar o
/// texto, para o histórico continuar fazendo sentido mesmo depois dos números mudarem.
model Report {
