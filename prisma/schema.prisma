  @@index([datasetId, uf, municipioIbge])
  @@index([datasetId, uf, situacaoCadastral])
  @@index([datasetId, municipioIbge, situacaoCadastral])
  @@index([datasetId, municipioIbge, icpTier])
  @@index([datasetId, municipioNomeSearch])
