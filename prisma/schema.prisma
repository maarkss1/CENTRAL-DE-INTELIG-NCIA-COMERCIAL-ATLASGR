/// Severidade da notificação — define o ícone e a cor de status na interface.
enum NotificationKind {
  Info
  Sucesso
  Alerta
  Erro
}

model Notification {
  id       String           @id @default(cuid())
  title    String
  body     String?
  kind     NotificationKind @default(Info)
  /// Entidade de origem, para a notificação poder levar o usuário ao lead/atividade que a gerou.
  entity   String?
  entityId String?
  readAt   DateTime?
  /// Destinatário específico; `null` significa "toda a organização".
  userId   String?

  /// Quando foi criada por uma automação, guarda qual — permite explicar a origem na interface.
  automationId String?
  automation   Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, readAt, createdAt])
}

/// Evento que dispara uma automação.
enum AutomationTrigger {
  Lead_Criado         @map("Lead criado")
  Lead_Mudou_Status   @map("Lead mudou de status")
  Atividade_Concluida @map("Atividade concluída")
  Lead_Estagnado      @map("Lead estagnado")
}

/// O que a automação faz quando dispara.
enum AutomationAction {
  Notificar_Equipe @map("Notificar equipe")
  Criar_Atividade  @map("Criar atividade")
  Ligar_SDR_Voz    @map("Ligar via SDR de Voz")
}

model Automation {
  id      String  @id @default(cuid())
  name    String
  enabled Boolean @default(true)

  trigger    AutomationTrigger
  /// Filtro opcional do gatilho (ex: `{ "status": "Proposta" }`). Vazio = dispara sempre.
  conditions Json?

  action       AutomationAction
  /// Parâmetros da ação (ex: título da notificação, tipo/prazo da atividade a criar).
  actionConfig Json

  /// Telemetria de execução, para a tela mostrar se a regra está realmente rodando.
  lastRunAt DateTime?
  runCount  Int       @default(0)

  notifications Notification[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /// DEC-14 (dossiê CPI, Onda 42): histórico de versões da REGRA (não das execuções — isso já
  /// existe via AuditLog/automation-history.service.ts).
  versions AutomationVersion[]

  @@index([organizationId, enabled])
}

/// DEC-14 (dossiê CPI, Onda 42, opção A): histórico de versões da REGRA de uma automação
/// (trigger/condições/ação/config) — não das execuções dela. Cada registro é um snapshot do
/// estado da regra imediatamente ANTES de uma edição ou remoção; o estado "atual" sempre é a
/// própria linha em Automation (ou deixa de existir, no caso de remoção).
model AutomationVersion {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  /// Snapshot da regra ANTES da edição/remoção que gerou este registro.
  name         String
  enabled      Boolean
  trigger      AutomationTrigger
  conditions   Json?
  action       AutomationAction
  actionConfig Json

  /// Quem fez a edição/remoção que tornou este snapshot histórico (não quem criou o estado
  /// snapshotado). Sem FK de propósito — mesmo padrão já usado no schema pelo mesmo motivo
  /// (OrganizationFeatureFlag.updatedByUserId, BugReport.userId/userEmail): o histórico deve
  /// sobreviver à remoção do usuário (ex-funcionário).
  editedByUserId String?
  editedByEmail  String?
  /// 'update' | 'delete' — 'delete' registra o último estado antes da automação ser removida, para
  /// o histórico não desaparecer junto com a regra.
  changeReason String @default("update")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([automationId, createdAt])
  @@index([organizationId])
}

/// Lista interna de bloqueio de discagem: números para os quais o SDR de voz não pode ligar.
///
/// Existe porque o opt-out precisa valer no ato — quem pede "não me liguem mais" durante a ligação
/// não pode receber a próxima tentativa da campanha. Guardar o número já em E.164 é o que faz o
/// mesmo telefone cadastrado em formatos diferentes ("(11) 99999-8888", "011999998888") cair no
/// mesmo bloqueio, em vez de escapar por diferença de pontuação.
model CallSuppression {
  id String @id @default(cuid())

  /// Telefone normalizado em E.164 (`+5511999998888`) — é a chave real do bloqueio.
  phoneE164 String
  /// De onde veio o bloqueio: `call-opt-out` (pedido na própria ligação), `manual`, `import`.
  source    String
  /// Texto livre para auditoria (ex: trecho da transcrição em que o lead pediu para não ligar).
  reason    String?

  /// Lead em que o pedido aconteceu, quando houve um. Fica nulo em bloqueios importados de uma
  /// lista externa, e SET NULL na exclusão: apagar o lead não pode reabilitar a discagem.
  leadId String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// O bloqueio é por organização (cada tenant tem sua própria lista) e único por número, para o
  /// registro do opt-out ser idempotente — o webhook pode reentregar o mesmo evento.
  @@unique([organizationId, phoneE164])
  @@index([organizationId])
}

/// Mensagem trocada pelo WhatsApp (Baileys), enviada ou recebida. Sem esta tabela, mensagens
/// recebidas eram descartadas — o handler `messages.upsert` de whatsapp.service.ts só tinha um
/// comentário "// TODO: salvar no CRM no futuro". `contactId`/`leadId` ficam nulos quando o
/// número remetente não corresponde a nenhum contato já cadastrado no tenant.
model WhatsAppMessage {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Id da mensagem no WhatsApp — idempotência: o Baileys pode reentregar o mesmo evento após uma
  /// reconexão.
  waMessageId String
  direction   String // 'inbound' | 'outbound'
  /// Telefone normalizado em E.164 do lado remoto (quem mandou, se inbound; quem recebeu, se outbound).
  phoneE164   String
  body        String? @db.Text

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  receivedAt DateTime @default(now())

  @@unique([organizationId, waMessageId])
  @@index([organizationId, phoneE164])
  @@index([leadId])
}

/// Sinal de intenção extraído por IA de uma janela de mensagens de WhatsApp já persistidas em
/// `WhatsAppMessage` — não duplica o conteúdo da conversa, só o resultado estruturado da leitura
/// (ver `conversation-intelligence.service.ts`). Gerado por um worker assíncrono, nunca no caminho
/// de recebimento da mensagem.
model ConversationSignal {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Canal de onde a janela de mensagens veio — 'whatsapp' (default, comportamento histórico
  /// antes desta coluna existir) ou 'email' (entrega 3 do Agente 17, reply tracking de e-mail —
  /// ver `src/features/cadence/domain/replyTracking.ts`). Não é o `scope` de OptOutRecord: aqui é
  /// só de onde o sinal foi lido, sempre um dos `CadenceChannel` reais.
  channel String @default("whatsapp")

  /// Quantas mensagens da janela foram lidas nesta análise — só para auditoria, não é exibido como fato de negócio.
  messageCount Int

  intent          String? // ex: "alta_intencao_compra" | "duvida_tecnica" | "objecao_preco" | "sem_interesse" | "neutro"
  urgency         String? // "alta" | "media" | "baixa"
  objections      String[]
  budgetMentioned Boolean  @default(false)
  nextStep        String?  @db.Text
  summary         String?  @db.Text
  /// Confiança do próprio modelo na classificação (0-1), quando ele reporta — usado para não tratar
  /// leituras incertas como se fossem fato.
  confidence      Float?

  /// JSON bruto devolvido pelo modelo — auditoria/depuração, o mesmo espírito do `rawData` em `EnrichmentLog`.
  rawModelOutput Json?

  createdAt DateTime @default(now())

  @@index([organizationId, leadId, createdAt])
}

/// Conexão real de Google Workspace (Gmail + Calendar) de uma organização — antes disso,
/// google.service.ts era inteiramente simulado (`access_token: 'mock_token'`), sem persistir nada.
/// Um registro por organização: é a integração do tenant, não de um usuário individual.
model GoogleWorkspaceConnection {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Conta Google conectada — mostrado na tela de Integrações.
  email        String
  /// Cifrados em repouso (AES-256-GCM) de forma transparente pela extensão Prisma em
  /// src/lib/prisma.ts — ver src/lib/crypto/secretFields.ts.
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  scope        String
  expiresAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Conexão do Bitrix24 de uma organização — webhook de entrada gerado pelo próprio usuário no
/// portal Bitrix24 dele (Aplicativos > Webhooks > Webhook de entrada, escopo "crm"). Antes disso
/// a URL do webhook não era persistida em lugar nenhum: cada exportação exigia colar a URL de
/// novo no corpo da requisição, e não havia nenhuma tela para configurá-la. Um registro por
/// organização, igual ao padrão do GoogleWorkspaceConnection acima.
/// Uma organização Atlas pode falar com MAIS DE UM portal Bitrix24 ao mesmo tempo (ex.: AtlasGR e
/// TotalTrac são marcas/empresas distintas, cada uma com seu próprio Bitrix) — por isso não é mais
/// 1:1 com Organization (era @unique antes; várias linhas por organizationId agora são o normal).
/// Cada conexão é independente: sua própria importação seletiva, seus próprios pipelines/etapas,
/// suas próprias regras de sincronização automática (ver BitrixSyncRule.connectionId).
model BitrixConnection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Nome de exibição pra distinguir as conexões na tela (ex.: "AtlasGR", "TotalTrac") — livre,
  /// não precisa bater com o domínio real do portal.
  label String @default("Bitrix24")

  /// URL completa do webhook de entrada, incluindo o token (ex: https://SEUDOMINIO.bitrix24.com.br/rest/1/xxxxxxxx/).
  /// Cifrada em repouso (AES-256-GCM) de forma transparente pela extensão Prisma em
  /// src/lib/prisma.ts — ver src/lib/crypto/secretFields.ts. A coluna em si continua `Text` porque
  /// o valor cifrado (formato "enc:v1:...") é mais longo que a URL original; a proteção de tenant
  /// via RLS permanece como camada adicional, não substituída por isto.
  webhookUrl String @db.Text

  /// Checkpoint da última importação bem-sucedida (crm.lead.list filtrado por >DATE_MODIFY a
  /// partir daqui) — sem isto, cada rodada do worker periódico teria que reprocessar os leads
  /// inteiros do portal a cada 15 minutos em vez de só o que mudou.
  lastImportedAt DateTime?

  /// Segredo do webhook de SAÍDA do Bitrix ("исходящий вебхук") que este portal chama de volta —
  /// gerado pelo Atlas, colado pela pessoa no cadastro do webhook de saída no admin do Bitrix.
  /// Comparado contra `auth.application_token` de cada evento recebido (ver bitrix.webhook.ts)
  /// antes de aceitar qualquer payload — sem isto, a rota seria um endpoint público aceitando
  /// qualquer POST. Cifrado em repouso do mesmo jeito que webhookUrl (ver ENCRYPTED_FIELDS em
  /// src/lib/prisma.ts).
  webhookSecret        String? @db.Text
  /// Só processa eventos de entrada (ONCRMLEADUPDATE etc.) quando true — desligado por padrão:
  /// gerar o segredo não é o mesmo que já ter colado a URL no Bitrix, e aceitar eventos de um
  /// webhook de saída ainda não configurado lá não tem como acontecer de verdade, mas o flag
  /// deixa a intenção explícita em vez de inferir do segredo existir ou não.
  inboundEventsEnabled Boolean @default(false)

  syncRules      BitrixSyncRule[]
  syncLogs       BitrixSyncLog[]
  extractionRuns BitrixExtractionRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

/// Regra de sincronização automática Bitrix → Atlas (ver bitrixSync.worker.ts). Diferente da
/// importação manual (listBitrixLeads/listBitrixDeals, sempre por escolha explícita na tela),
/// isto é opt-in por regra: só existe automação para o que o usuário definiu aqui, escopado por
/// pipeline/etapa/vendedor — nunca "importar tudo que aparecer", que encheria o CRM de lixo (o
/// portal mistura prospecção real com notificações de e-mail automáticas, chamados de suporte
/// etc.). Sem nenhuma regra ativa, o worker não faz nada.
model BitrixSyncRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Qual conexão/portal Bitrix esta regra observa — uma organização pode ter mais de uma
  /// conexão (ex.: AtlasGR e TotalTrac), então a regra precisa dizer qual delas, não só o tenant.
  connectionId String
  connection   BitrixConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  /// "deal" (objeto Negócio, com pipeline/etapa reais) ou "lead" (objeto Lead, lista plana de
  /// status — sem pipeline). Portais diferentes usam um, outro, ou os dois em paralelo.
  source String @default("deal")

  /// CATEGORY_ID do pipeline de Negócio a observar (ex: "28" = Comercial) — obrigatório quando
  /// source="deal", ignorado quando source="lead" (Lead não tem pipeline).
  categoryId   String?
  /// STAGE_ID (Deal) ou STATUS_ID (Lead) opcional — sem isso, a regra observa todas as etapas/status.
  stageId      String?
  /// ASSIGNED_BY_ID opcional — sem isso, a regra observa registros de qualquer vendedor.
  assignedById String?

  active Boolean @default(true)

  lastRunAt         DateTime?
  lastImportedCount Int       @default(0)
  /// Mensagem da última falha de execução (null se a última tentativa teve sucesso) — fecha a
  /// lacuna descrita no comentário de runBitrixSyncTick: antes disso o schema não tinha onde
  /// guardar POR QUE uma regra estava falhando, só QUANDO ela tentou pela última vez.
  lastError         String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([connectionId])
  @@index([active])
}

/// Trilha de auditoria por operação de sincronização Bitrix (import, export, push automático,
/// evento de webhook de entrada) — granularidade que BitrixSyncRule.lastRunAt/lastImportedCount
/// não tem (só o resumo da última rodada de UMA regra). Responde "este lead foi realmente
/// enviado/recebido do Bitrix, quando, e com que resultado?" por registro, não só por regra.
model BitrixSyncLog {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId   String?
  connection     BitrixConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  /// 'inbound' (Bitrix → Atlas: import manual, regra automática, webhook) ou 'outbound' (Atlas → Bitrix).
  direction      String
  /// 'lead' ou 'deal' — qual objeto Bitrix esta operação tocou.
  entityType     String
  /// Lead local afetado, quando existe (pode ser null num evento de webhook para um Bitrix ID
  /// ainda não importado — a operação é só ignorada, mas fica registrada mesmo assim).
  leadId         String?
  /// ID do registro no Bitrix (Lead ou Deal, conforme entityType).
  bitrixRecordId String?

  /// 'success' | 'failed' | 'skipped'
  status        String
  errorMessage  String? @db.Text
  /// Mesmo correlationId usado nos logs estruturados (client.ts/outboundSync.ts) — permite achar
  /// a chamada HTTP exata que gerou esta linha nos logs da aplicação.
  correlationId String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([leadId])
  @@index([connectionId, createdAt])
}

enum BitrixExtractionStatus {
  queued
  running
  completed
  /// Extração terminou e gerou arquivo utilizável, mas atingiu PAGE_SAFETY_CAP (teto de segurança
  /// de páginas) para ao menos uma entidade antes de esgotar o portal Bitrix24 — distinto de
  /// `completed` (esgotou o portal) e de `failed` (não gerou arquivo nenhum). Ver handoff
  /// `.agents/handoffs/roadmap-v2-onda-1/06-para-01-status-extracao-parcial.md`.
  completed_partial
  failed
  cancelled
}

/// Histórico de execuções do módulo "Extrações Bitrix" (06A) — uma linha por extração disparada
/// (Negócios/Leads/Empresas/Contatos/Atividades/Usuários, com campos `UF_CRM_*` dinâmicos,
/// filtros e exportação CSV/XLSX/JSON). Ver handoff preparatório
/// `.agents/handoffs/onda-1/06-para-01-schema-extracoes-bitrix-historico.md` (schema sugerido
/// pelo 06A) e `.agents/handoffs/onda-6/01A-para-06-bitrix-extraction-run-schema.md` (formato
/// final coordenado nesta onda).
///
/// Retenção/LGPD: histórico e arquivos gerados contêm dado pessoal real (nome/e-mail/telefone de
/// leads/contatos extraídos do Bitrix). A janela de retenção é PARAMETRIZADA
/// (`BITRIX_EXTRACTION_RETENTION_DAYS`, `src/config/env.ts`, default 45 dias — confirmado pelo
/// dono do produto em 2026-08-15, ver .agents/handoffs/onda-6/01A-para-06-bitrix-extraction-run-schema.md)
/// em vez de gravada como número fixo nesta migration, exatamente para não bloquear a existência
/// do schema numa decisão humana ainda pendente (ver seção "Retenção" do handoff acima). O worker
/// de expurgo correspondente (`bitrixExtractionPurge.worker.ts`) fica DESLIGADO por padrão
/// (`BITRIX_EXTRACTION_PURGE_ENABLED=false`) até essa confirmação humana existir — ligar a flag
/// sem o valor de dias revisado não deve apagar nada por omissão.
model BitrixExtractionRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Qual portal Bitrix foi extraído — mesmo padrão de BitrixSyncRule/BitrixSyncLog. `SetNull` (não
  /// `Cascade`): apagar a conexão não deve apagar o histórico/arquivos já gerados, só desvincular.
  connectionId String?
  connection   BitrixConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  /// userId de quem disparou a extração (auditoria — "quem exportou este dado pessoal e quando").
  requestedBy String?

  /// Quais entidades foram pedidas: deal/lead/company/contact/activity/user (uma ou mais).
  entities String[]
  /// Campos selecionados por entidade, incluindo `UF_CRM_*` escolhidos dinamicamente no portal —
  /// formato livre porque o conjunto de campos customizados varia por portal Bitrix.
  fields   Json
  /// Período (custom/hoje/7 dias/mês/trimestre/semestre/tudo) + pipeline/etapa/responsável/status/
  /// busca/campo de data usado como filtro desta extração.
  filters  Json

  status BitrixExtractionStatus @default(queued)

  /// Versão de BITRIX_FIELD_MAP (bitrixFieldMap.ts) vigente no momento desta extração — permite
  /// confirmar contra qual mapeamento UF_CRM_* os dados foram interpretados se o portal for
  /// reconfigurado depois. Nullable: extrações anteriores a esta coluna não têm esse dado (nunca
  /// inferido retroativamente).
  schemaVersion String?

  /// Progresso por entidade: total estimado, processado, página/lote atual, erros parciais.
  progress      Json?
  totalCount    Int   @default(0)
  /// Contagem final por entidade (ex.: {"lead": 120, "deal": 45}).
  countByEntity Json?

  /// Sanitizado — nunca stack trace ou segredo (mesmo padrão de BitrixSyncRule.lastError).
  errorMessage  String? @db.Text
  correlationId String?
  attempts      Int     @default(0)

  /// Metadados do(s) arquivo(s) exportado(s) (formato, path/URL de storage, tamanho, geradoEm) —
  /// nunca o conteúdo do arquivo nesta linha. Excluir uma extração precisa remover o arquivo
  /// associado no storage, não só esta linha (ver worker de expurgo).
  files Json?

  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  /// DEC-04 (dossiê CPI, Onda 42, opção B): preenchido pelo worker de expurgo LGPD
  /// (bitrixExtractionPurge.worker.ts) quando este run é anonimizado por retenção expirada — nunca
  /// apagado, só anonimizado (arquivos removidos do storage, filters.search redigido). `null` =
  /// nunca expurgado. Usado tanto para o filtro WHERE do worker (`purgedAt: null`) quanto para a
  /// UI sinalizar "dado pessoal já removido por retenção".
  purgedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([connectionId])
  @@index([status])
  @@index([organizationId, purgedAt])
}

/// Conexão de PABX 3CX de uma organização (Click-to-Call / Call Control API) — antes deste modelo,
/// threecx.service.ts guardava tudo (URL do PABX, ramal, apiKey/apiSecret) num `Map` em memória
/// (`memory3CXStore`), perdido a cada restart/redeploy do processo e inconsistente entre
/// instâncias quando há mais de um processo do servidor rodando (ver handoff
/// .agents/handoffs/onda-1/06-para-01-persistencia-3cx.md). Mesmo padrão de BitrixConnection: uma
/// organização pode ter mais de um PABX 3CX (ex.: AtlasGR e TotalTrac com telefonia separada), por
/// isso não é @unique por organizationId.
model ThreeCXConnection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Nome de exibição pra distinguir as conexões na tela — livre, mesmo espírito de
  /// BitrixConnection.label.
  label String @default("3CX")

  /// URL completa do servidor 3CX PABX (ex.: https://my-pbx.3cx.us), sem barra final.
  pbxUrl String

  /// Ramal 3CX usado para originar chamadas (Click-to-Call).
  extension String

  /// Credenciais de API do PABX (Call Control). Cifradas em repouso (AES-256-GCM) de forma
  /// transparente pela extensão Prisma em src/lib/prisma.ts — ver src/lib/crypto/secretFields.ts,
  /// mesmo tratamento de BitrixConnection.webhookUrl/GoogleWorkspaceConnection.accessToken.
  /// Nullable: nem todo PABX exige API key/secret configurados para Call Control básico.
  apiKey    String? @db.Text
  apiSecret String? @db.Text

  /// Liga/desliga o disparo automático de chamada (ex.: a partir de uma automação) para este PABX.
  autoDialEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

/// Registro unificado de opt-out multicanal (e-mail/WhatsApp/voz), proposto pelo Agente 17 em
/// .agents/handoffs/onda-7/17-para-01-schema-cadencia-optout-proposta.md e aplicado aqui para
/// destravar o handoff bloqueador .agents/handoffs/onda-7/17-para-05-06-12-contrato-optout.md —
/// antes deste modelo, CallSuppression (model abaixo) só protegia o canal de voz, e um lead que
/// pedisse para não ser incomodado num canal continuava recebendo mensagem pelos outros dois.
/// Casamento por leadId (mais forte) OU email OU phoneE164 — ver src/features/cadence/domain/optOut.ts
/// e src/features/cadence/application/optOutService.ts (lógica de domínio já implementada/testada
/// pelo 17, este model é só o adaptador de persistência que faltava).
enum OptOutScope {
  Email
  WhatsApp
  Voice
  Global
}

model OptOutRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  scope OptOutScope

  /// Identificadores de correspondência: casa por QUALQUER um destes três que o canal disparador
  /// já tiver carregado do Lead antes de tentar o envio — email/phoneE164 cobrem o opt-out
  /// registrado antes de o lead existir localmente (ex.: webhook de descadastro chegando antes do
  /// primeiro sync).
  leadId    String?
  lead      Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  email     String?
  phoneE164 String?

  /// Canal por onde o pedido chegou — não é o escopo do bloqueio (ver `scope` acima).
  originChannel String
  reason        String?
  /// Texto/trecho real da mensagem que motivou o opt-out — nunca inferência do modelo de IA.
  evidence      String?
  requestedBy   String?

  createdAt DateTime @default(now())

  @@index([organizationId, leadId])
  @@index([organizationId, phoneE164])
  @@index([organizationId, email])
}

/// Um registro por execução da campanha de prospecção fria (ver coldCall.service.ts). Sem isto a
/// campanha rodava 100% invisível — só `logger.info`, sem nenhuma tela para a operação ver o que
/// o SDR de voz fez (quantos discou, quantos pulou e por quê).
model ColdCallRun {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  scanned            Int
  called             Int
  skippedMaxAttempts Int     @default(0)
  skippedCooldown    Int     @default(0)
  skippedNoPhone     Int     @default(0)
  skippedSuppressed  Int     @default(0)
  skippedError       Int     @default(0)
  /// Preenchido quando a execução nem chegou a examinar leads (ex: fora da janela de discagem).
  haltedBy           String?

  runAt DateTime @default(now())

  @@index([organizationId, runAt])
}

model AIPendingAction {
  id             String        @id @default(cuid())
  entity         String
  action         String
  payload        Json
  /// Papel que originou a decisão (SDR, BDR, CLOSER, CRM, OPS ou SUPERVISOR).
  agentRole      String?
  /// Classificação de risco operacional para a UI e para políticas de autoexecução.
  riskLevel      String        @default("medium")
  /// Confiança declarada/derivada da decisão, normalizada entre 0 e 1.
  confidence     Float?
  /// Chave de idempotência por tenant. Impede que um worker repetido proponha/envie a mesma ação.
  idempotencyKey String?
  approved       Boolean       @default(false)
  approvedAt     DateTime?
  /// Onda 39 (auditoria CPI — "trilha completa de aprovação"): id do usuário (User.id) que
  /// aprovou/descartou esta ação, nunca inferido — ambos vêm de req.user na rota autenticada, o
  /// mesmo usuário já responsável pelo RBAC de /pending/:id (ver pending-actions.service.ts).
  approvedBy     String?
  discardedAt    DateTime?
  discardedBy    String?
  /// Se a ação aprovada foi de fato executada (ex: e-mail enviado de verdade via SMTP). Sem este
  /// campo, "aprovar" só marcava um flag no banco e nada consumia isso depois (IA-005) — o
  /// executor real fica em src/features/intelligence/services/aiPendingAction.service.ts.
  executed       Boolean       @default(false)
  executedAt     DateTime?
  /// Preenchido quando a execução foi tentada e falhou (ex: SMTP fora do ar). `executed`
  /// continua false nesse caso — a tela usa isso para decidir se ainda oferece o fallback manual.
  executionError String?
  attempts       Int           @default(0)
  lastAttemptAt  DateTime?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, approved])
  @@index([organizationId, discardedAt, approved, createdAt], map: "AIPendingAction_autonomy_queue_idx")
}

/// Modelo/provedor de IA escolhido para cada ferramenta (toolKey = chave em ContentTool, ex.
/// "script_call", "risk"), editável pela tela AIConfigCenter. Quando não há registro para uma
/// ferramenta, o serviço cai no TOOL_CONFIG hardcoded como padrão.
model AiEngineSetting {
  id          String   @id @default(cuid())
  toolKey     String   @unique
  provider    String
  model       String
  temperature Float
  updatedAt   DateTime @updatedAt
}

// ==========================================
// AtlasGR Prospect - Motor de Prospecção
// ==========================================

model Prospect {
  id              String  @id @default(cuid())
  cnpj            String?
  companyName     String
  fantasyName     String?
  confidenceScore Int     @default(0)

  // Dados Brutos e Enriquecidos
  enrichedData Json?
  intelligence Json? // SWOT, BANT, Objeções
  leadScore    Int?

  status   String  @default("NEW") // NEW, ENRICHING, READY, EXPORTED
  bitrixId String?

  // Relações com o CRM Principal
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Controle de Tenant
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Era `@@unique` global (auditoria: colidia entre organizações diferentes — a Organização A
  // cadastrando um Prospect com um CNPJ impedia a Organização B de cadastrar Prospect com o
  // mesmo CNPJ). Escopado por tenant, mesmo padrão e mesma justificativa já aplicados a
  // Company.cnpj (ver comentário lá) — depende do mesmo pré-requisito: todo write path de `cnpj`
  // grava normalizado (dígitos puros, src/lib/cnpj.ts), nunca em formatos diferentes.
  @@unique([organizationId, cnpj])
  @@index([organizationId])
  @@index([status])
  @@index([companyId])
  @@index([leadId])
}

// ─── Feature Flags (governança de 12 requisitos — item 7: Loja de Apps / Feature Flags) ────
// Duas tabelas: FeatureFlag é o catálogo global (chave, descrição, valor default). Organization-
// FeatureFlag é o override por tenant — só existe uma linha quando uma organização diverge do
// default global. Resolução em featureFlags.service.ts: override da organização se existir,
// senão o default global.
//
// Isto complementa, não substitui, o padrão ad-hoc já existente de flag via variável de ambiente
// + allowlist de organizationId (ex.: SDR_COLD_CALL_ENABLED/SDR_COLD_CALL_ORGANIZATIONS,
// SWARM_SCHEDULER_ENABLED/SWARM_SCHEDULER_ORGANIZATIONS em src/config/env.ts) — aquele padrão
// continua servindo para flags que exigem redeploy; este sistema serve para flags que um ADMIN
// precisa ligar/desligar em runtime, por organização, sem deploy nem alteração de código.
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  /// Valor aplicado a toda organização que não tem override próprio em OrganizationFeatureFlag.
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationOverrides OrganizationFeatureFlag[]
}

model OrganizationFeatureFlag {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  featureFlagId   String
  featureFlag     FeatureFlag  @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  enabled         Boolean
  /// Id do usuário ADMIN que fez a última alteração — só informativo/auditoria leve, sem FK
  /// (o usuário pode ser removido depois sem invalidar o histórico do flag).
  updatedByUserId String?
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, featureFlagId])
  @@index([organizationId])
}

// ─── Bug Reports (governança de 12 requisitos — item 8: Módulo de Reportar Problemas) ──────
// Criado pelo botão flutuante `BugReportButton` (src/components/ui/BugReportButton.tsx) via
// POST /api/bug-reports. `context` guarda um snapshot técnico capturado automaticamente no
// momento do report (URL, papel do usuário, marca ativa, user agent, viewport, e as últimas
// entradas de log do clientLogger) — nunca texto livre do usuário além de title/description,
// para reduzir o risco de PII/segredo acabar em campo de texto. Ver sanitização de `context`
// em bugReport.service.ts antes de persistir.
model BugReport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Sem relação FK para User de propósito: o relato precisa sobreviver à remoção do usuário
  /// (ex.: ex-funcionário) — mesmo raciocínio de `updatedByUserId` acima.
  userId         String?
  userEmail      String?
  title          String
  description    String       @db.Text
  /// LOW | MEDIUM | HIGH | CRITICAL — mesmo padrão de string livre documentada usado em
  /// Prospect.status/CommercialGoal etc. neste schema, em vez de enum Prisma.
  severity       String       @default("MEDIUM")
  /// OPEN | TRIAGED | RESOLVED
  status         String       @default("OPEN")
  context        Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

// ─── Cadência multicanal, reply tracking, agendamento e proposta/assinatura/fechamento ──────
// (Onda 10, Agente 01A) — itens 2-5 da proposta completa do Agente 17 em
// `.agents/handoffs/onda-7/17-para-01-schema-cadencia-optout-proposta.md`. O item 1 daquele
// handoff (`OptOutRecord`, enum `OptOutScope`) já estava em produção antes desta onda — ver acima.
//
// Toda a lógica de domínio (máquina de estados de cadência, matching de opt-out, guardas de
// confirmação verificável, versionamento de proposta, guarda de fechamento determinístico) já
// existe testada e pura em `src/features/cadence/domain/**`, com portas (`*Repository`/`*Port`)
// implementadas hoje só em memória (`src/features/cadence/infra/InMemory*`). Os models abaixo são
// a persistência real que faltava — os adaptadores Prisma (equivalente a
// `PrismaOptOutRepository.ts`) ficam para quando o 17 retomar o trabalho, fora do escopo desta
// onda (`prisma/schema.prisma` é propriedade exclusiva do 01/01A).
//
// Convenção de enum herdada de `OptOutScope`/`OptOutRecord` (já em produção): valores PascalCase
// no Postgres, mapeados para os literais lowercase/kebab/snake do domínio TypeScript
// (`CadenceChannel`, `CadenceRunStatus` etc. em `src/features/cadence/domain/*.ts`) por um
// adaptador na camada de persistência — nunca propagados crus para o resto do código. Não é
// enum-por-enum idêntico ao domínio de propósito (ver nota em cada enum abaixo).
//
// Todas as tabelas novas seguem o padrão já estabelecido (`id` cuid, `organizationId` com FK
// `ON DELETE CASCADE` para `Organization`, RLS `tenant_isolation_policy` idêntica à de
// `OptOutRecord`/`BitrixExtractionRun`). Duas correções em relação ao SQL literal do handoff do
// 17 (registradas aqui porque o handoff é histórico e não deve ser reescrito, ver protocolo de
// handoff em `/AGENTS.md`):
// 1. `CadenceSequence`, `CadenceRun`, `CadenceTouchAttempt`, `EmailMessage`,
//    `CadenceCalendarEvent`, `CrmCommercialDocumentVersion`, `CrmDocumentSignatureRequest` e
//    `DealClosureEvent` ganharam a FK `organizationId → Organization` que o SQL do handoff listava
//    a coluna mas não a constraint — a própria proposta do 17 promete esse padrão no parágrafo de
//    abertura ("organizationId com FK ON DELETE CASCADE para Organization"), então tratado aqui
//    como lacuna de transcrição, não como decisão de omitir.
// 2. `CadenceRun_leadId_active_unique` (índice único parcial `WHERE status = 'Active'`, que
//    impede duas cadências ativas simultâneas para o mesmo lead) não é representável na DSL do
//    Prisma (sem suporte a índice parcial) — existe só na migration SQL manual, com um
//    `@@index([leadId])` normal aqui no schema para a consulta comum. `prisma db pull`/`migrate
//    diff` vai sempre reportar esse índice específico como fora do schema — conhecido e aceito,
//    documentado de novo no comentário do model abaixo.

enum CadenceChannel {
  Email
  WhatsApp
  Voice
}

enum CadenceRunStatus {
  Active
  Paused
  Stopped
  Completed
  Failed
}

enum CadenceStopReason {
  OptOut
  LeadReply
  Completed
  ManualStop
  PolicyGuardrail
}

enum CadenceTouchResult {
  Sent
  Failed
  Skipped
}

/// Definição reutilizável de uma sequência de toques multicanal (ex.: e-mail → WhatsApp → voz →
/// e-mail) — ver `src/features/cadence/domain/cadence.ts` (`CadenceSequenceDefinition`).
/// `touches` é a lista ordenada de passos, validada em runtime por `validateSequence` (sem lacunas
/// nem repetição de `order`), não por constraint de banco.
model CadenceSequence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?

  /// [{ "order": 1, "channel": "Email", "delayHoursFromPrevious": 0, "templateRef": "...",
  /// "maxAttempts": 1 }, ...] — ver `CadenceTouch` no domínio.
  touches Json

  active    Boolean   @default(true)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  runs CadenceRun[]

  @@index([organizationId, active])
}

/// Uma execução de `CadenceSequence` para um Lead específico — estado vivo da máquina de estados
/// em `src/features/cadence/domain/cadence.ts` (`CadenceRunState`). `currentTouchOrder` é o
/// próximo toque a tentar; a sequência terminou quando não existe mais `touch` com esse `order`.
///
/// `CadenceRun_leadId_active_unique` (índice único parcial `WHERE status = 'Active'`) garante em
/// banco que um lead nunca tem duas cadências ativas concorrendo pelo mesmo canal — constraint só
/// na migration SQL, não representável nesta DSL (ver nota no topo da seção). O
/// `@@index([leadId])` abaixo é só para a consulta comum, não substitui a garantia de unicidade.
model CadenceRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  sequenceId String
  sequence   CadenceSequence @relation(fields: [sequenceId], references: [id], onDelete: Restrict)

  status            CadenceRunStatus   @default(Active)
  currentTouchOrder Int                @default(1)
  stopReason        CadenceStopReason?

  startedAt   DateTime  @default(now())
  lastTouchAt DateTime?
  pausedAt    DateTime?
  stoppedAt   DateTime?
  createdBy   String?
  updatedAt   DateTime  @updatedAt

  touchAttempts  CadenceTouchAttempt[]
  calendarEvents CadenceCalendarEvent[]

  @@index([organizationId, status])
  @@index([leadId])
}

/// Uma tentativa real de disparo de um toque de cadência — nunca `Sent` sem confirmação real do
/// provedor (mesma disciplina de honestidade de envio corrigida em `cold-email.service.ts`, commit
/// `2e42a557`; ver `recordTouchAttempt` no domínio, que só marca `sent` quando o chamador
/// confirma).
model CadenceTouchAttempt {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  cadenceRunId String
  cadenceRun   CadenceRun @relation(fields: [cadenceRunId], references: [id], onDelete: Cascade)

  touchOrder        Int
  attemptNumber     Int                @default(1)
  channel           CadenceChannel
  attemptedAt       DateTime           @default(now())
  result            CadenceTouchResult
  skipReason        String?
  error             String?            @db.Text
  providerMessageId String?

  @@index([organizationId])
  @@index([cadenceRunId])
}

/// Persistência de mensagens de e-mail (entrega 3 do Agente 17 — reply tracking) — simétrico a
/// `WhatsAppMessage`, mas para o canal de e-mail. `providerMessageId` (header `Message-Id`) dá
/// idempotência de reentrega; `inReplyTo` (header `In-Reply-To`) dá threading. Compartilhado com o
/// Agente 05 (dono de e-mail/SMTP) — formato coordenado em
/// `.agents/handoffs/onda-7/17-para-05-06-12-contrato-optout.md`; ver
/// `src/features/cadence/domain/replyTracking.ts` para a lógica de detecção de resposta genuína
/// (`isGenuineLeadReply`) que consome estas linhas.
model EmailMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Header Message-Id — idempotência de reentrega (o mesmo webhook/IMAP pode reentregar).
  providerMessageId String
  /// Header In-Reply-To — threading.
  inReplyTo         String?
  direction         String // 'inbound' | 'outbound', mesmo padrão de WhatsAppMessage.direction
  fromEmail         String
  toEmail           String
  subject           String?
  body              String? @db.Text

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  receivedAt DateTime @default(now())

  @@unique([organizationId, providerMessageId])
  @@index([leadId])
}

/// As três únicas formas de confirmação de disponibilidade que o domínio aceita como verificáveis
/// (`ConfirmationEvidenceType` em `src/features/cadence/domain/scheduling.ts`,
/// `isVerifiableConfirmation`) — nunca inferência de um modelo de IA sobre o texto de uma
/// mensagem.
enum ConfirmationEvidenceType {
  /// Lead respondeu confirmando explicitamente um horário específico já proposto.
  LeadCalendarReply
  /// Lead escolheu um horário num link de agendamento self-service (ex.: página de slots).
  LeadSchedulingLinkClick
  /// Vendedor confirmou manualmente após contato ao vivo — ainda exige `confirmationEvidenceRef`.
  ManualVerified
}

/// Reunião comercial agendada a partir de uma confirmação verificável (entrega 4 do Agente 17) —
/// ver `scheduleMeetingIfConfirmed`/`buildCalendarEventDraft` no domínio. A criação real do evento
/// no Google Calendar é responsabilidade de `google.service.ts` (Agente 06); esta linha é o
/// registro comercial do agendamento, com `googleEventId` preenchido depois que a chamada real ao
/// Google confirma.
model CadenceCalendarEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  cadenceRunId String?
  cadenceRun   CadenceRun? @relation(fields: [cadenceRunId], references: [id], onDelete: SetNull)

  /// Preenchido só depois que `CalendarSchedulerPort.createEvent` confirma a criação real no
  /// Google Calendar — nulo enquanto o agendamento é só comercial/local.
  googleEventId String?

  confirmationEvidenceType ConfirmationEvidenceType
  /// Id do registro real que prova a confirmação (id de mensagem, id de clique no link de
  /// agendamento, id de nota do vendedor) — nunca um resumo gerado por IA.
  confirmationEvidenceRef  String

  scheduledStart DateTime
  scheduledEnd   DateTime
  ownerUserId    String?
  /// 'scheduled' | 'cancelled' | 'completed'
  status         String   @default("scheduled")

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([organizationId])
}

/// Fotografia imutável de `CrmCommercialDocument` em um instante (entrega 5, parte 1 — proposta
/// versionada). O histórico nunca é mutado: cada revisão é um novo registro, nunca um
/// `UPDATE` sobre uma versão existente — ver `draftNextProposalVersion`/`nextVersionNumber` em
/// `src/features/cadence/domain/proposal.ts`, que garante o próximo número sempre maior que
/// qualquer existente, mesmo se versões intermediárias forem removidas.
model CrmCommercialDocumentVersion {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  documentId    String
  document      CrmCommercialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int

  /// Snapshot completo do documento neste ponto no tempo (title/lineItems/subtotal/discount/tax/
  /// total/terms/notes) — ver `ProposalSnapshot` no domínio.
  snapshot Json

  changedBy    String?
  changeReason String?
  createdAt    DateTime @default(now())

  @@unique([documentId, versionNumber])
  @@index([organizationId])
}

enum SignatureRequestStatus {
  Created
  Sent
  Viewed
  Signed
  Declined
  Expired
  Cancelled
}

/// Solicitação de assinatura eletrônica de uma proposta/documento comercial (entrega 5, parte 2).
/// `provider` é TEXT livre (não enum) — decisão de negócio já tomada em 2026-08-15 (ver "##
/// Decisão do usuário" no handoff original): provedor real é a Assinatura Eletrônica gov.br
/// (`'govbr'`), mas o schema fica agnóstico de propósito para não exigir migration de enum se um
/// provedor comercial complementar (ex.: signatário sem conta gov.br) precisar entrar depois.
model CrmDocumentSignatureRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  documentId String
  document   CrmCommercialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Texto livre — valor real hoje é `'govbr'`. Ver comentário do model.
  provider          String
  providerRequestId String?
  status            SignatureRequestStatus @default(Created)
  signerEmail       String
  signerName        String?
  requestedBy       String?
  requestedAt       DateTime               @default(now())
  respondedAt       DateTime?
  /// URL/id do certificado de assinatura devolvido pelo provedor.
  evidenceRef       String?
  rawWebhookPayload Json?

  @@index([documentId])
  @@index([organizationId])
}

enum DealClosureEventType {
  SignatureCompleted
  PaymentConfirmed
  ManualCrmConfirmation
}

/// Ledger append-only do que moveu um Lead para "Negócios Ganhos" — fechamento determinístico
/// (entrega 5, parte 2). Único caminho legítimo, por acordo com o Agente 13
/// (`.agents/handoffs/onda-7/17-para-13-evento-fechamento.md`): substitui a proibição absoluta de
/// `AUTONOMIA_COMERCIAL_24X7.md` ("a transição para Negócios Ganhos não deve ser decidida por
/// texto gerado") por um evento de tipo fechado com evidência real, nunca criado a partir de
/// texto/julgamento de um agente de IA — ver `isDeterministicCloseEvent`/`evaluateDealClosure` em
/// `src/features/cadence/domain/dealClosure.ts`, que já rejeita `triggeredBy` que pareça vir de um
/// agente (`ai:`/`agent:`/`swarm:`/`closer:`/`bot:`).
model DealClosureEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type DealClosureEventType

  /// Id de outro registro real que prova o evento (CrmDocumentSignatureRequest, referência de
  /// pagamento, ou Activity/Note de confirmação manual) — nunca um resumo/texto gerado.
  evidenceRef    String
  /// userId de quem confirmou manualmente, ou 'webhook:<provider>' quando automático — nunca um
  /// agente de IA (ver checagem de `triggeredBy` no domínio).
  triggeredBy    String
  previousStatus String?
  occurredAt     DateTime @default(now())

  @@index([leadId])
  @@index([organizationId])
}

model ThreeCXCallEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId   String? // ThreeCXConnection.id resolvida pelo extension, quando possível
  extension      String?
  callId         String? // id do 3CX, para idempotência de reentrega
  eventType      String
  rawPayload     Json // payload cru
  createdAt      DateTime     @default(now())

  @@unique([organizationId, callId, eventType])
  @@index([organizationId, createdAt])
}

model PublicBookingLink {
  id             String       @id @default(cuid())
  slug           String       @unique
  title          String
  description    String?
  durationMin    Int          @default(30)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, userId])
  @@index([slug])
}

model SavedSearch {
  id              String       @id @default(cuid())
  name            String
  criteria        Json         // { segment, location, fleetSizeMin, keywords, radiusKm, lat, lng }
  schedule        String?      // "daily" | "weekly" | null
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  leadsDiscovered Int          @default(0)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  /// Onda 40 (auditoria CPI — "funil técnico-comercial quebra no primeiro elo, busca→lead"):
  /// leads promovidos a partir de um candidato descoberto por esta busca salva. `leadsDiscovered`
  /// acima já contava quantos candidatos uma execução encontrou, mas nenhum Lead real guardava de
  /// qual busca salva ele veio — este relation fecha essa rastreabilidade.
  leads Lead[]

  /// DEC-13 (dossiê CPI, Onda 42): relação irmã de `leads` acima, do lado da EXECUÇÃO — quando uma
  /// busca veio de POST /saved-searches/:id/run, não de /discover direto.
  searchExecutions ProspectingSearchExecution[]

  @@index([organizationId])
}

/// DEC-13 (dossiê CPI, Onda 42, opção A): Search-ID formal rastreável — amarra critério de busca →
/// providers chamados → resultados → custo de ponta a ponta, para auditoria/replay. `SavedSearch`
/// acima só guarda o FILTRO salvo; este model é o registro de cada EXECUÇÃO individual.
model ProspectingSearchExecution {
  /// Search-ID — cuid gerado em aplicação (SearchExecutionTracker, ver searchExecution.service.ts)
  /// no INÍCIO de cada execução real de busca, não pelo @default(cuid()) do Prisma — precisa
  /// existir ANTES do INSERT para propagar nos logs estruturados da execução inteira, inclusive
  /// quando ela falha antes de qualquer persistência.
  id              String       @id
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  savedSearchId String?
  savedSearch   SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)

  /// Mesmo formato de SavedSearch.criteria — ProspectCriteria serializado.
  criteria Json

  /// 'free' | 'hybrid' — snapshot de getProspectingProviderMode() no momento da execução.
  providerMode String

  /// Array ordenado de chamadas reais a provider dentro desta execução — ver
  /// SearchExecutionProviderCall em searchExecution.service.ts para o shape exato.
  providersCalled Json

  totalResults Int @default(0)

  /// Custo estimado acumulado desta execução (USD), soma de providersCalled[].costUsd.
  costUsd Decimal @default(0) @db.Decimal(10, 4)

  /// 'success' | 'partial' | 'error' — texto livre (não enum), mesmo padrão já usado em outros
  /// campos de status "narrativo" deste schema.
  status       String
  errorMessage String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// finishedAt - startedAt em ms — redundante com os dois campos acima, evita todo consumidor de
  /// auditoria/replay precisar recalcular a mesma subtração.
  durationMs Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, startedAt])
  @@index([savedSearchId])
}

