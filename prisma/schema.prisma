/// Crosswalk persistido Receita -> IBGE; a API não associa município por texto em runtime.
model MarketIntelligenceMunicipalityMapping {
  id            String   @id
  receitaCode   String   @unique
  receitaName   String
  uf            String
  ibgeCode      String
  ibgeName      String
  region        String?
  mappingMethod String
  sourceVersion String
  importedAt    DateTime @default(now())

  @@index([ibgeCode])
  @@index([uf, ibgeName])
}

model EnrichmentLog {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source    String // BrasilAPI-CNPJ | BrasilAPI-CEP | AI-Estimate | Domain-Heuristic | GDELT-News | Email-Verification | Lookalike-PgVector
  field     String // o que foi enriquecido (ex: "dados-cadastrais", "endereco", "contatos-sugeridos")
  status    String // success | not_found | failed
  rawData   Json?

  dataOrigin       String? // "confirmado" | "inferido"
  appliedToCompany Boolean?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

model Contact {
  id                  String        @id @default(cuid())
  name                String
  role                String?
  department          String?
  // phone/whatsapp/email cifrados em repouso (AES-256-GCM, ver src/lib/crypto/piiFields.ts) desde
  // a reativação do CPI "PII de lead/contato não cifrada em repouso" — o valor gravado aqui é
  // ciphertext (`enc:v1:...`), nunca texto puro, decifrado de forma transparente pela extensão do
  // Prisma em src/lib/prisma.ts. Os índices `*Index`/`*Last8Index` abaixo (HMAC-SHA256
  // determinístico, src/lib/crypto/piiIndex.ts) existem justamente porque IV aleatório por valor
  // faz igualdade/contains direto nesta coluna nunca casar — nenhuma busca deve filtrar por estes
  // três campos diretamente, sempre pelo índice correspondente. Substitui `phoneHash`/
  // `whatsappHash`/`emailHash` (DEC-01/onda-42, `src/lib/security/piiSearchIndex.ts`) — aquela
  // rodada implementou só o mecanismo de busca (campo original continuava em texto puro), deixando
  // a cifra em si e a migration como handoff pendente
  // (`.agents/handoffs/onda-42/01-para-00-pii-hash-fields.md`); este conjunto de campos completa
  // exatamente esse handoff (cifra reativada + índice mais completo: domínio de e-mail e sufixo de
  // 8/9 dígitos de telefone, que o hash único de DEC-01 não cobria).
  phone               String?
  whatsapp            String?
  email               String?
  // Índice cego de igualdade exata sobre `email` normalizado (trim + lowercase) — substitui todo
  // WHERE que antes fazia `email: { equals, mode: 'insensitive' }` contra o campo cifrado.
  emailIndex          String?
  // Índice cego sobre o domínio do e-mail (parte após `@`) — substitui todo WHERE que antes fazia
  // `email: { endsWith: '@dominio', mode: 'insensitive' }` (ex.: rate limit de cadência por
  // domínio, PrismaCadenceRateLimitPort.ts).
  emailDomainIndex    String?
  // Índice cego de igualdade exata sobre `phone` exatamente como armazenado (sem normalizar
  // dígitos) — substitui todo WHERE que antes fazia `phone: contact.phone` direto.
  phoneIndex          String?
  // Índice cego sobre os últimos 8 dígitos de `phone` — substitui o antigo `phone: { contains:
  // últimos8Dígitos }` usado pelos webhooks de voz (Bland AI/3CX) pra casar chamada com contato.
  phoneLast8Index     String?
  // Índice cego sobre os últimos 9 dígitos de `phone` — substitui o antigo `regexp_replace(...)
  // LIKE '%últimos9Dígitos'` usado por whatsappMessage.service.ts pra casar mensagem recebida com
  // contato (9, não 8: convenção própria desse fluxo, já existente antes deste índice).
  phoneLast9Index     String?
  whatsappIndex       String?
  whatsappLast8Index  String?
  whatsappLast9Index  String?
  linkedin            String?
  birthDate           DateTime?
  observations        String?
  status              ContactStatus @default(Ativo)
  source              String? // ex: "Apollo", "Hunter"
  seniority           String? // ex: "c_suite", "vp", "director", "manager" — vindo da Apollo/Hunter
  emailStatus         String? // ex: "verified", "guessed" — confiabilidade do e-mail encontrado
  aiProcessingConsent Boolean? // Consentimento LGPD explícito/titular para processamento de IA externa

  customFields        Json?
  commercialDocuments CrmCommercialDocument[]

  companyId             String
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads                 Lead[]
  whatsAppMessages      WhatsAppMessage[]
  organizationId        String?
  organization          Organization?     @relation(fields: [organizationId], references: [id])
  decisionMakerProfiles DecisionMaker[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  // DecisionMaker referencia este trio para garantir no banco que contato, conta e tenant sao os
  // mesmos. Os campos pessoais continuam apenas em Contact; o LDR nao cria uma copia global.
  @@unique([id, companyId, organizationId])
  @@index([organizationId])
  @@index([name])
  @@index([role])
  // Substituem os antigos @@index([email])/@@index([phone])/@@index([whatsapp]) — inúteis contra
  // ciphertext (IV aleatório nunca repete), ver comentário nos campos acima. Também substituem
  // phoneHash/whatsappHash/emailHash (DEC-01/onda-42) — ver comentário grande no topo do model.
  @@index([emailIndex])
  @@index([emailDomainIndex])
  @@index([phoneIndex])
  @@index([phoneLast8Index])
  @@index([phoneLast9Index])
  @@index([whatsappIndex])
  @@index([whatsappLast8Index])
  @@index([whatsappLast9Index])
}

model Lead {
  id String @id @default(cuid())

  // New CRM fields
  status          LeadStatus       @default(Lead_Recebido)
  source          String?
  channel         String?
  temperature     LeadTemperature?
  score           Int?
  owner           String?
  lastInteraction DateTime?
  nextAction      DateTime?
  // Quando o lead entrou em Fechado_Ganho/Fechado_Perdido, setado só nessa transição de status
  // (ver PrismaLeadRepository.updateStatus). Métricas de "ganho/perdido no mês" (analytics.service.ts)
  // não podem usar `updatedAt` pra isso: esse campo é @updatedAt e sobe em QUALQUER update do
  // registro (sync do Bitrix, uma ligação do SDR de voz tocando só lastInteraction, etc.), não só
  // em mudança de status — um lead fechado em março podia contar como "ganho em agosto" só porque
  // outra coisa tocou nele depois. Volta a null se o lead for reaberto pra uma etapa não-final.
  closedAt        DateTime?
  // PIC (Perfil de Cliente Ideal) do Playbook de Pré-Vendas Atlas — setado manualmente pelo SDR/AM
  // após identificar o gatilho real na conversa (não é inferido automaticamente): "PIC1_Expansao"
  // (transportadora em expansão operacional), "PIC2_Risco" (sob pressão de risco/sinistro), ou
  // "PIC3_Transicao" (transição de liderança/reestruturação).
  pic             String?
  // Checklist de qualificação do SDR (Playbook Comercial AtlasGR, seção 4.2) — contexto
  // operacional, estrutura atual, dor mapeada, interesse/autoridade e próximo passo. Estruturado
  // como JSON (ver LeadQualification no frontend) em vez de ~20 colunas separadas.
  qualification   Json?
  title           String?
  amount          Float?
  currency        String           @default("BRL")
  probability     Int?
  expectedCloseAt DateTime?
  customFields    Json?

  // Funil do Lead (objeto Lead x objeto Negócio do Bitrix24) e campos comerciais que só existiam
  // no Bitrix — ver migration 20260805220000_two_funnels_and_bitrix_fields para o remapeamento
  // dos dados existentes. Ainda não lidos/escritos pelo PrismaLeadRepository (fora do escopo desta
  // sincronização de schema).
  funnel                     LeadFunnel @default(Lead)
  resumeDate                 DateTime?
  cadenceStage               String?
  lossReason                 String?
  dealPackage                String?
  dealStatus                 String?
  relationshipLevel          String?
  commissionPercent          String?
  partnerBroker              String?
  qualificationValidatedByAM Boolean?

  // Sincronização bidirecional com o Bitrix24 (ver bitrix.service.ts) — o ID do Lead lá no
  // portal do cliente. Sem isso, cada rodada de importação recriaria os mesmos 99+ leads de novo
  // (não há outra chave natural: nome de empresa se repete, telefone pode faltar). Não é @unique
  // "hard" porque cada organização fala com o SEU PRÓPRIO portal Bitrix — múltiplos tenants nunca
  // colidem no mesmo ID na prática, mas travar isso com constraint global é desnecessário.
  bitrixLeadId       String?
  // Mesma ideia de bitrixLeadId, mas para importação a partir do objeto Deal (Negócio) do Bitrix
  // — usado quando a organização importa pelo funil de vendas real (com pipeline/etapa), não pelo
  // objeto Lead cru. Campo separado porque IDs de Lead e Deal são namespaces distintos no Bitrix
  // (podem colidir numericamente sem ter nenhuma relação entre si).
  bitrixDealId       String?
  // Nome da etapa como está no Bitrix (ex: "Novo Lead (Distribuidoras)" para Lead, ou "Proposta
  // Enviada" para Deal) — preservado à parte do `status` mapeado pro enum interno, porque o
  // Bitrix tem estágios/categorias específicas do negócio do cliente que não têm equivalente 1:1
  // no nosso LeadStatus fixo.
  bitrixStageLabel   String?
  // Data de assinatura do contrato — UF_CRM_1770928318695 no objeto Lead do Bitrix (achado em
  // public/tools/portal-comercial, ex-extrator-bitrix.html, fora do BITRIX_FIELD_MAP original). Não existe código
  // equivalente conhecido no objeto Deal.
  contractSignedDate DateTime?

  // Status de sincronização OUTBOUND (Atlas → Bitrix) — fecha a lacuna descrita em
  // outboundSync.ts/pushLeadToBitrix: antes disso uma falha no push automático só existia no log,
  // nunca na tela. 'pending' = nunca sincronizado; 'syncing' = claim em andamento (trava de
  // concorrência, ver syncLeadToBitrix); 'synced' = última tentativa teve sucesso; 'failed' =
  // última tentativa falhou (bitrixSyncError carrega o motivo).
  bitrixSyncStatus String?
  bitrixSyncError  String?   @db.Text
  bitrixSyncedAt   DateTime?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// Onda 40 (auditoria CPI — "funil técnico-comercial quebra no primeiro elo, busca→lead"):
  /// preenchido quando este Lead foi promovido a partir de um candidato descoberto por uma busca
  /// salva (ver prospecting.service.ts, promoteToCrm). `SetNull`: apagar a busca salva não deve
  /// apagar o lead já promovido, só desvincular o histórico de proveniência.
  savedSearchId String?
  savedSearch   SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)

  pipelineId      String?
  pipeline        CrmPipeline?      @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  pipelineStageId String?
  pipelineStage   CrmPipelineStage? @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)

  activities            Activity[]
  timeline              TimelineEvent[]
  internalNotes         Note[]
  whatsAppMessages      WhatsAppMessage[]
  conversationSignals   ConversationSignal[]
  dealItems             CrmDealItem[]
  commercialDocuments   CrmCommercialDocument[]
  stageHistory          LeadStageHistory[]
  fieldChanges          LeadFieldChange[]
  optOutRecords         OptOutRecord[]
  prospects             Prospect[]
  // Onda 10 (Agente 01A) — ver proposta do Agente 17, itens 2/3/4/5.
  cadenceRuns           CadenceRun[]
  emailMessages         EmailMessage[]
  cadenceCalendarEvents CadenceCalendarEvent[]
  dealClosureEvents     DealClosureEvent[]
  organizationId        String?
  organization          Organization?           @relation(fields: [organizationId], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  // Fecha a janela de corrida de duplicidade descrita no comentário de bitrixLeadId/bitrixDealId
  // acima: dois imports/exports concorrentes do MESMO registro Bitrix não conseguem mais criar
  // dois Leads locais (o segundo INSERT falha com violação de unique, tratada como "já
  // importado"/"já sincronizado" pelo chamador). NULL não colide com NULL em unique index do
  // Postgres — leads sem vínculo Bitrix continuam livres para existir aos milhares sem restrição.
  @@unique([organizationId, bitrixLeadId])
  @@unique([organizationId, bitrixDealId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, funnel])
  @@index([organizationId, pipelineId, pipelineStageId])
  @@index([bitrixLeadId])
  @@index([bitrixDealId])
  @@index([savedSearchId])
}

model Activity {
  id           String         @id @default(cuid())
  type         ActivityType
  owner        String
  date         DateTime
  time         String?
  status       ActivityStatus @default(Pendente)
  observations String?

  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  @@index([organizationId])
}

model TimelineEvent {
  id          String @id @default(cuid())
  type        String // creation, edition, movement, activity, comment, generic
  description String

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Note {
