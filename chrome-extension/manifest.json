{
  "manifest_version": 3,
  "name": "Copiloto Comercial IA — Atlas GR",
  "version": "0.2.0",
  "description": "Copiloto Comercial IA da Central Atlas GR: detecta o Google Meet, captura consentimento e vincula a reunião a um Lead do CRM via backend próprio (nunca fala com o Bitrix24 diretamente).",
  "default_locale": "pt_BR",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:3005/*",
    "http://127.0.0.1:3005/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "action": {
    "default_title": "Abrir Copiloto Atlas GR"
  }
}
