NODE_ENV=development
# 3005 é a porta padrão de dev (ver .claude/launch.json) — é a que está cadastrada como
# redirect_uri no Client OAuth do Google Cloud Console. Rodar em outra porta quebra o login com
# Google (redirect_uri_mismatch).
PORT=3005
HOST=0.0.0.0
# Aponte para o papel NOSUPERUSER da aplicação (prospector_app), nunca para o superusuário de
# bootstrap do Postgres (POSTGRES_USER do docker-compose/k8s) — RLS nunca se aplica a superusuário,
# então conectar como ele torna toda política de isolamento de tenant no banco decorativa (ver N1
# em docs/auditoria-divida-tecnica/08-PLANO-DE-SEGURANCA.md). Papel criado por
# scripts/db/create-app-role.sql (automático no docker-compose local; manual via
# scripts/db/bootstrap-app-role.sh em outros ambientes).
DATABASE_URL=postgresql://prospector_app:prospector_app_pass@localhost:5434/prospectordb
# Produção (Render): use a Session Pooler connection string do Supabase (porta 5432,
# aws-0-<region>.pooler.supabase.com) como DATABASE_URL — funciona tanto para o tráfego da
# aplicação quanto para `prisma migrate deploy`. Ver docs/deploy/producao.md secao 1.
# DIRECT_URL é opcional: só necessária se a Session Pooler apresentar problema com advisory locks
# do Prisma migrate (nesse caso, aponte para a Direct Connection db.<ref>.supabase.co:5432).
# Sem DIRECT_URL definida, prisma.config.ts cai automaticamente para DATABASE_URL.
DIRECT_URL=
ALLOWED_ORIGINS=http://localhost:3005,http://localhost:3000,http://localhost:5173
BETTER_AUTH_URL=http://localhost:3005
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Chave mestra que cifra em repouso credenciais de integrações (webhook Bitrix, tokens Google) —
# ver src/lib/crypto/secretFields.ts. Gere com `openssl rand -base64 32`. Obrigatória em produção
# (a aplicação recusa subir sem ela quando NODE_ENV=production); em dev/test, se ausente, usa uma
# chave fixa de desenvolvimento com aviso no log — nunca use isso fora do seu ambiente local.
CREDENTIALS_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# Mesmas credenciais servem para DOIS fluxos OAuth distintos no mesmo Client do Google Cloud:
# 1. "Entrar com Google" (login, via better-auth) — redirect_uri: {BETTER_AUTH_URL}/api/auth/callback/google
# 2. "Conectar Google Workspace" (Gmail/Calendar, ver google.service.ts) — redirect_uri:
#    {PUBLIC_BASE_URL}/api/google/callback
# Cadastre AMBOS os redirect URIs no mesmo Client OAuth no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# O acesso em produção é restrito aos domínios corporativos atlasgr.com.br e totaltrac.com.br
ALLOW_DEV_AUTH_BYPASS=false
API_RATE_LIMIT_MAX=600
AI_RATE_LIMIT_MAX=30
# Requisições POST por IP a cada 15min em /api/auth (login/cadastro). Mantenha baixo em produção
# (proteção contra força bruta); suítes E2E que criam muitas contas reais sequencialmente podem
# precisar de um valor maior neste ambiente.
AUTH_RATE_LIMIT_MAX=20
# Requisições POST por organização a cada 15min em /api/bug-reports (botão "Reportar problema").
BUG_REPORT_RATE_LIMIT_MAX=10
JSON_BODY_LIMIT=2mb
TRUST_PROXY=false
EXPOSE_METRICS=false
ENABLE_SEARCH=false
ENABLE_QUEUES=false
ENRICHMENT_CACHE_TTL_SECONDS=86400

# "free" blocks billable prospecting providers even if a key is present.
# "hybrid" enables each optional provider whose key is configured below.
PROSPECTING_PROVIDER_MODE=free
GOOGLE_MAPS_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
# Webhook de entrada do Bitrix24 usado como conexão padrão quando não houver conexão salva.
# ATENÇÃO: a URL contém o token de acesso — é uma CREDENCIAL. Nunca commite o valor real.
# Portal AtlasGR (marca padrão) e portal TotalTrac respectivamente; sem a env, a organização
# conecta manualmente pela tela de Integrações (nenhum default hardcoded existe no código).
BITRIX24_WEBHOOK_URL=
TOTALTRAC_BITRIX24_WEBHOOK_URL=
CNPJ_PROVIDER=brasilapi

REDIS_URL=
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Storage de objetos (uploads, S3-compatível) ─────────────────────────────
# Ver src/lib/storage/index.ts. Sem STORAGE_ACCESS_KEY_ID/STORAGE_SECRET_ACCESS_KEY, o storage de
# objetos fica inerte (getUploadUrl/getDownloadUrl lançam erro explícito), sem impedir o resto da
# aplicação de subir. Em produção, gere as chaves S3 do Supabase Storage em
# Project Settings > Storage > S3 Connection (ver docs/deploy/producao.md secao 1.2).
# Dev local (MinIO via docker-compose, se você tiver o serviço rodando): endpoint
# http://localhost:9000, region us-east-1.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=prospector-assets
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Voicebox (TTS local para VoiceRoleplay) — instância compartilhada rodando em
# C:\Users\Mah\Documents\GitHub\voicebox via docker compose. VOICEBOX_PROFILE_ID
# ── Motores de IA Self-Hosted / Nuvem (Ollama / LiteLLM) ──────────────────────
# Para rodar com Ollama na nuvem/VPS (Docker container atlas_ollama): http://ollama:11434
# Para rodar com Ollama na máquina local: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=ollama
LITELLM_URL=http://localhost:4000
LITELLM_KEY=

# Observabilidade de IA (Langfuse self-hosted)
LANGFUSE_BASEURL=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# OpenTelemetry Collector
OTEL_SERVICE_NAME=atlasgr-commercial-intelligence
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Logs estruturados → Loki (src/lib/logger.ts). Sem LOKI_HOST, o pino grava só em stdout
# (pino-pretty em dev, JSON puro em produção) — mesmo com o container do Loki de pé via
# `npm run infra:up` (docker-compose.opensource.yml), nenhum log chega lá até esta variável
# ser definida. Dev local com a stack opensource rodando: http://localhost:3100.
LOKI_HOST=
AI_GATEWAY_TIMEOUT_MS=30000
AI_FALLBACK_TIMEOUT_MS=60000
AI_EMBEDDING_TIMEOUT_MS=30000

# ── SDR de voz (Birth Voices Hub) ───────────────────────────────────────────
# Repositório BIRTH-VOICES-HUB. Sem estas variáveis a integração fica inerte: nenhuma ligação é
# disparada e o webhook responde 503, em vez de impedir a aplicação de subir.
BIRTH_VOICES_URL=http://localhost:3001
BIRTH_VOICES_API_KEY=
# Id do agente cadastrado no Birth Voices Hub que vai conduzir a ligação.
BIRTH_VOICES_AGENT_ID=
# Precisa ser exatamente o mesmo valor do WEBHOOK_SIGNING_SECRET no Birth Voices Hub — é o segredo
# compartilhado que assina/valida o resultado da chamada. Sem ele, o webhook rejeita tudo.
BIRTH_VOICES_WEBHOOK_SECRET=
# Chave da API Bland AI, usada para autenticar chamadas quando o baseUrl da conexão de voz for
# bland.ai (src/features/integrations/birth-voice/birthVoice.service.ts).
BLAND_API_KEY=
# URL pública DESTA aplicação, informada ao Hub para ele devolver o resultado da ligação.
# Em desenvolvimento use um túnel (ngrok), porque localhost não é alcançável de fora.
PUBLIC_BASE_URL=http://localhost:3000
# Segredo do webhook /api/webhooks/voice-result (resultado de ligação da Bland AI). Configure o
# mesmo valor no header x-atlasgr-webhook-secret do lado da Bland. Sem ele o webhook responde 503
# (fail-closed) — nunca há valor default.
ATLASGR_WEBHOOK_SECRET=

# ── Prospecção fria (discagem automática) ───────────────────────────────────
# Precisa das DUAS chaves abaixo: a flag e a lista de organizações. Nenhuma sozinha liga a
# campanha — discar para quem nunca pediu contato é a operação mais arriscada do sistema, e
# habilitar por engano tem que ser difícil. Antes de ligar, decida a base legal (LGPD) do contato.
SDR_COLD_CALL_ENABLED=false
# Ids de organização separados por vírgula. Vazio = ninguém, mesmo com a flag em true.
SDR_COLD_CALL_ORGANIZATIONS=
# Janela de discagem no fuso do destinatário. O fim é exclusivo: 18 = liga até 17:59. Fim de semana
# nunca é discado. A campanha roda a cada 15 minutos e só age dentro desta janela.
SDR_CALL_WINDOW_START=9
SDR_CALL_WINDOW_END=18
SDR_CALL_TIMEZONE=America/Sao_Paulo
# Ritmo e insistência: teto por execução, tentativas por lead, e intervalo mínimo entre duas
# tentativas para a mesma pessoa.
SDR_MAX_CALLS_PER_RUN=10
SDR_MAX_ATTEMPTS_PER_LEAD=3
SDR_RETRY_COOLDOWN_HOURS=48

# Enxame comercial autônomo 24/7. Precisa destas duas chaves e de Redis/ENABLE_QUEUES=true.
SWARM_SCHEDULER_ENABLED=false
# Ids separados por vírgula. Vazio = ninguém. Use * somente como opt-in consciente para todos.
SWARM_SCHEDULER_ORGANIZATIONS=
SWARM_SCHEDULER_MAX_LEADS_PER_RUN=5
# supervised exige aprovação para contato externo; full permite o primeiro e-mail automático
# somente acima do score mínimo e dentro da janela comercial definida para o SDR.
SWARM_AUTONOMY_MODE=supervised
SWARM_AUTONOMOUS_MIN_SCORE=80
SWARM_NEW_LEAD_GRACE_MINUTES=30
SWARM_STALE_PIPELINE_HOURS=72
SWARM_STALE_PROPOSAL_HOURS=48
SWARM_RECOMMENDATION_COOLDOWN_HOURS=24

# ── Envio real de e-mail (executor de AIPendingAction, IA-005) ──────────────
# Todas opcionais: sem SMTP_HOST, "aprovar" um rascunho de e-mail volta a só abrir o cliente de
# e-mail do próprio usuário (mailto:), em vez de enviar de verdade.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remetente exibido no e-mail. Cai para SMTP_USER quando ausente.
SMTP_FROM=
