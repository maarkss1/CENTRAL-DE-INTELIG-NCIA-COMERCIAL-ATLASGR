NODE_ENV=development
# 3005 é a porta padrão de dev (ver .claude/launch.json) — é a que está cadastrada como
# redirect_uri no Client OAuth do Google Cloud Console. Rodar em outra porta quebra o login com
# Google (redirect_uri_mismatch).
PORT=3005
HOST=0.0.0.0
# Aponte para o papel NOSUPERUSER da aplicação (prospector_app), nunca para o superusuário de
# bootstrap do Postgres (POSTGRES_USER do docker-compose/k8s) — RLS nunca se aplica a superusuário,
# então conectar como ele torna toda política de isolamento de tenant no banco decorativa (ver N1
# em docs/auditoria-divida-tecnica/08-PLANO-DE-SEGURANCA.md). Papel criado por
# scripts/db/create-app-role.sql (automático no docker-compose local; manual via
# scripts/db/bootstrap-app-role.sh em outros ambientes).
DATABASE_URL=postgresql://prospector_app:prospector_app_pass@localhost:5434/prospectordb
# Produção (Render): use a Session Pooler connection string do Supabase (porta 5432,
# aws-0-<region>.pooler.supabase.com) como DATABASE_URL — funciona tanto para o tráfego da
# aplicação quanto para `prisma migrate deploy`. Ver docs/deploy/producao.md secao 1.
# DIRECT_URL é opcional: só necessária se a Session Pooler apresentar problema com advisory locks
# do Prisma migrate (nesse caso, aponte para a Direct Connection db.<ref>.supabase.co:5432).
# Sem DIRECT_URL definida, prisma.config.ts cai automaticamente para DATABASE_URL.
DIRECT_URL=
ALLOWED_ORIGINS=http://localhost:3005,http://localhost:3000,http://localhost:5173
BETTER_AUTH_URL=http://localhost:3005
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Domínio do cookie de sessão (better-auth) — deixe vazio em dev (usa o host da própria request).
# Force SECURE_COOKIES=true se precisar testar cookie `secure` fora de produção (ex.: atrás de um
# proxy HTTPS local); em produção o cookie já é secure independente desta variável.
COOKIE_DOMAIN=
SECURE_COOKIES=false
# Chave mestra que cifra em repouso credenciais de integrações (webhook Bitrix, tokens Google) —
# ver src/lib/crypto/secretFields.ts. Gere com `openssl rand -base64 32`. Obrigatória em produção
# (a aplicação recusa subir sem ela quando NODE_ENV=production); em dev/test, se ausente, usa uma
# chave fixa de desenvolvimento com aviso no log — nunca use isso fora do seu ambiente local.
CREDENTIALS_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# Chave do índice cego (HMAC-SHA256) que permite busca exata sobre Contact.email/phone/whatsapp
# cifrados em repouso — ver src/lib/crypto/piiIndex.ts. Gere com `openssl rand -base64 32` (use
# uma chave DIFERENTE de CREDENTIALS_ENCRYPTION_KEY). Mesma obrigatoriedade condicional acima:
# obrigatória em produção, chave fixa de dev com aviso no log se ausente fora dela. Substitui
# PII_SEARCH_HMAC_SECRET (DEC-01/onda-42) — ver comentário em src/config/env.ts.
PII_BLIND_INDEX_KEY=replace-with-openssl-rand-base64-32
# Mesmas credenciais servem para DOIS fluxos OAuth distintos no mesmo Client do Google Cloud:
# 1. "Entrar com Google" (login, via better-auth) — redirect_uri: {BETTER_AUTH_URL}/api/auth/callback/google
# 2. "Conectar Google Workspace" (Gmail/Calendar, ver google.service.ts) — redirect_uri:
#    {PUBLIC_BASE_URL}/api/google/callback
# Cadastre AMBOS os redirect URIs no mesmo Client OAuth no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# O acesso em produção é restrito aos domínios corporativos atlasgr.com.br e totaltrac.com.br
ALLOW_DEV_AUTH_BYPASS=false
API_RATE_LIMIT_MAX=600
AI_RATE_LIMIT_MAX=30
# Requisições POST por IP a cada 15min em /api/auth (login/cadastro). Mantenha baixo em produção
# (proteção contra força bruta); suítes E2E que criam muitas contas reais sequencialmente podem
# precisar de um valor maior neste ambiente.
AUTH_RATE_LIMIT_MAX=20
# Requisições POST por organização a cada 15min em /api/bug-reports (botão "Reportar problema").
BUG_REPORT_RATE_LIMIT_MAX=10
JSON_BODY_LIMIT=2mb
TRUST_PROXY=false
EXPOSE_METRICS=false
# SEC-001/SEC-002: token de operador de plataforma, separado do papel ADMIN de tenant — exigido
# por /admin/queues (BullBoard) e, quando EXPOSE_METRICS=true, por /metrics. Sem valor aqui, as
# duas rotas negam acesso por padrão (fail-closed), mesmo para um ADMIN de organização real.
# Gere um valor forte (ex.: `openssl rand -hex 32`) e nunca reaproveite outro segredo do projeto.
PLATFORM_OPERATOR_TOKEN=
ENABLE_SEARCH=false
ENABLE_QUEUES=false
ENRICHMENT_CACHE_TTL_SECONDS=86400
# Só checada quando NODE_ENV=production: sobe os workers de fila embutidos no próprio processo web
# em vez de exigir um processo worker separado. Deixe em false se você já roda workers dedicados.
ENABLE_EMBEDDED_WORKERS=false
# debug | info | warn | error — nível mínimo do logger pino (src/lib/logger.ts).
LOG_LEVEL=info

# "free" blocks billable prospecting providers even if a key is present.
# "hybrid" enables each optional provider whose key is configured below.
PROSPECTING_PROVIDER_MODE=free
GOOGLE_MAPS_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
# Webhook de entrada do Bitrix24 usado como conexão padrão quando não houver conexão salva.
# ATENÇÃO: a URL contém o token de acesso — é uma CREDENCIAL. Nunca commite o valor real.
# Portal AtlasGR (marca padrão) e portal TotalTrac respectivamente; sem a env, a organização
# conecta manualmente pela tela de Integrações (nenhum default hardcoded existe no código).
BITRIX24_WEBHOOK_URL=
TOTALTRAC_BITRIX24_WEBHOOK_URL=
# Nomes alternativos aceitos como fallback pelas duas variáveis acima (connections.ts) — mantenha
# só um dos dois pares definido, nunca os dois com valores diferentes.
BITRIX_WEBHOOK_URL=
TOTALTRAC_BITRIX_WEBHOOK_URL=
# Circuit breaker do client HTTP do Bitrix (client.ts) — evita martelar o portal quando ele está
# fora do ar. Defaults já embutidos no código se ausentes.
BITRIX_CIRCUIT_BREAKER_ENABLED=true
BITRIX_CIRCUIT_BREAKER_THRESHOLD=5
BITRIX_CIRCUIT_BREAKER_COOLDOWN_MS=60000
# Diretório onde as extrações completas do Bitrix (BitrixExtractionRun) são salvas como arquivo em
# disco — histórico continua íntegro no Postgres mesmo se o arquivo for perdido num restart.
BITRIX_EXTRACTION_STORAGE_DIR=./data/bitrix-extractions
CNPJ_PROVIDER=brasilapi

REDIS_URL=
GROQ_API_KEY=
# Fallback real já suportado por src/lib/ai/gateway.ts quando GROQ_API_KEY não está configurada.
OPENAI_API_KEY=

# ── Storage de objetos (uploads, S3-compatível) ─────────────────────────────
# Ver src/lib/storage/index.ts. Sem STORAGE_ACCESS_KEY_ID/STORAGE_SECRET_ACCESS_KEY, o storage de
# objetos fica inerte (getUploadUrl/getDownloadUrl lançam erro explícito), sem impedir o resto da
# aplicação de subir. Em produção, gere as chaves S3 do Supabase Storage em
# Project Settings > Storage > S3 Connection (ver docs/deploy/producao.md secao 1.2).
# Dev local (MinIO via docker-compose, se você tiver o serviço rodando): endpoint
# http://localhost:9000, region us-east-1.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=prospector-assets
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Nomes legados aceitos como fallback pelas 3 variáveis STORAGE_* acima (src/lib/storage/index.ts)
# — resquício de quando o storage local era MinIO puro. Prefira sempre as STORAGE_* de cima.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Voicebox (TTS local para VoiceRoleplay) — instância compartilhada rodando em
# C:\Users\Mah\Documents\GitHub\voicebox via docker compose.
VOICEBOX_API_URL=http://127.0.0.1:17493
# Id do perfil de voz cadastrado no Voicebox a ser usado no roleplay. Sem valor, a chamada de TTS
# falha explicitamente (nenhum default seguro existe).
VOICEBOX_PROFILE_ID=

# ── Busca vetorial / embeddings ─────────────────────────────────────────────
# "local" roda o modelo de embeddings on-device (Transformers.js); "litellm" delega ao gateway.
EMBEDDINGS_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Xenova/multilingual-e5-base
LOCAL_EMBEDDING_CACHE=.cache/models
# Endpoint opcional de um servidor Text Embeddings Inference (Hugging Face) — se definido, é usado
# no lugar do modelo local em processo.
TEI_BASE_URL=
LITELLM_EMBEDDING_MODEL=text-embedding-3-small

# Busca de notícias/mercado (news.service.ts) — instância própria de SearXNG, opcional.
SEARXNG_URL=http://127.0.0.1:8080
# Pesquisa de mercado (marketResearchTool.ts) — pelo menos uma das duas habilita a ferramenta.
TAVILY_API_KEY=
SERPER_API_KEY=

# Busca full-text da Base de Conhecimento (search.service.ts) — sem MEILISEARCH_URL a feature
# fica inerte, sem impedir o resto da aplicação de subir.
MEILISEARCH_URL=
MEILISEARCH_KEY=

# Login "Entrar com Microsoft" (better-auth) — opcional, mesmo padrão de GOOGLE_CLIENT_ID/SECRET.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Motores de IA Self-Hosted / Nuvem (Ollama / LiteLLM) ──────────────────────
# Para rodar com Ollama na nuvem/VPS (Docker container atlas_ollama): http://ollama:11434
# Para rodar com Ollama na máquina local: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=ollama
LITELLM_URL=http://localhost:4000
LITELLM_KEY=
# Chave de admin/master do próprio LiteLLM (distinta de LITELLM_KEY, usada por mem0.ts) — default
# de dev já embutido no código (`sk-atlas-master`), troque em produção.
LITELLM_MASTER_KEY=sk-atlas-master

# Observabilidade de IA (Langfuse self-hosted)
LANGFUSE_BASEURL=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# OpenTelemetry Collector
OTEL_SERVICE_NAME=atlasgr-commercial-intelligence
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Logs estruturados → Loki (src/lib/logger.ts). Sem LOKI_HOST, o pino grava só em stdout
# (pino-pretty em dev, JSON puro em produção) — mesmo com o container do Loki de pé via
# `npm run infra:up` (docker-compose.opensource.yml), nenhum log chega lá até esta variável
# ser definida. Dev local com a stack opensource rodando: http://localhost:3100.
LOKI_HOST=
AI_GATEWAY_TIMEOUT_MS=30000
AI_FALLBACK_TIMEOUT_MS=60000
AI_EMBEDDING_TIMEOUT_MS=30000

# ── SDR de voz (Birth Voices Hub) ───────────────────────────────────────────
# Repositório BIRTH-VOICES-HUB. Sem estas variáveis a integração fica inerte: nenhuma ligação é
# disparada e o webhook responde 503, em vez de impedir a aplicação de subir.
BIRTH_VOICES_URL=http://localhost:3001
BIRTH_VOICES_API_KEY=
# Id do agente cadastrado no Birth Voices Hub que vai conduzir a ligação.
BIRTH_VOICES_AGENT_ID=
# Precisa ser exatamente o mesmo valor do WEBHOOK_SIGNING_SECRET no Birth Voices Hub — é o segredo
# compartilhado que assina/valida o resultado da chamada. Sem ele, o webhook rejeita tudo.
BIRTH_VOICES_WEBHOOK_SECRET=
# Chave da API Bland AI, usada para autenticar chamadas quando o baseUrl da conexão de voz for
# bland.ai (src/features/integrations/birth-voice/birthVoice.service.ts).
BLAND_API_KEY=
# URL pública DESTA aplicação, informada ao Hub para ele devolver o resultado da ligação.
# Em desenvolvimento use um túnel (ngrok), porque localhost não é alcançável de fora.
PUBLIC_BASE_URL=http://localhost:3000
# Segredo do webhook /api/webhooks/voice-result (resultado de ligação da Bland AI). Configure o
# mesmo valor no header x-atlasgr-webhook-secret do lado da Bland. Sem ele o webhook responde 503
# (fail-closed) — nunca há valor default.
ATLASGR_WEBHOOK_SECRET=

# ── Prospecção fria (discagem automática) ───────────────────────────────────
# Precisa das DUAS chaves abaixo: a flag e a lista de organizações. Nenhuma sozinha liga a
# campanha — discar para quem nunca pediu contato é a operação mais arriscada do sistema, e
# habilitar por engano tem que ser difícil. Antes de ligar, decida a base legal (LGPD) do contato.
SDR_COLD_CALL_ENABLED=false
# Ids de organização separados por vírgula. Vazio = ninguém, mesmo com a flag em true.
SDR_COLD_CALL_ORGANIZATIONS=
# Janela de discagem no fuso do destinatário. O fim é exclusivo: 18 = liga até 17:59. Fim de semana
# nunca é discado. A campanha roda a cada 15 minutos e só age dentro desta janela.
SDR_CALL_WINDOW_START=9
SDR_CALL_WINDOW_END=18
SDR_CALL_TIMEZONE=America/Sao_Paulo
# Ritmo e insistência: teto por execução, tentativas por lead, e intervalo mínimo entre duas
# tentativas para a mesma pessoa.
SDR_MAX_CALLS_PER_RUN=10
SDR_MAX_ATTEMPTS_PER_LEAD=3
SDR_RETRY_COOLDOWN_HOURS=48

# Enxame comercial autônomo 24/7. Precisa destas duas chaves e de Redis/ENABLE_QUEUES=true.
SWARM_SCHEDULER_ENABLED=false
# Ids separados por vírgula. Vazio = ninguém. Use * somente como opt-in consciente para todos.
SWARM_SCHEDULER_ORGANIZATIONS=
SWARM_SCHEDULER_MAX_LEADS_PER_RUN=5
# supervised exige aprovação para contato externo; full permite o primeiro e-mail automático
# somente acima do score mínimo e dentro da janela comercial definida para o SDR.
SWARM_AUTONOMY_MODE=supervised
SWARM_AUTONOMOUS_MIN_SCORE=80
SWARM_NEW_LEAD_GRACE_MINUTES=30
SWARM_STALE_PIPELINE_HOURS=72
SWARM_STALE_PROPOSAL_HOURS=48
SWARM_RECOMMENDATION_COOLDOWN_HOURS=24

# ── Envio real de e-mail (executor de AIPendingAction, IA-005) ──────────────
# Todas opcionais: sem SMTP_HOST, "aprovar" um rascunho de e-mail volta a só abrir o cliente de
# e-mail do próprio usuário (mailto:), em vez de enviar de verdade.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remetente exibido no e-mail. Cai para SMTP_USER quando ausente.
SMTP_FROM=

# Segredo do webhook /api/webhooks/email/inbound (CYC-003) — réplica de e-mail de entrada. Stub:
# sem provedor real de inbound-parse plugado ainda. Fail-closed: sem ele, 503.
EMAIL_INBOUND_WEBHOOK_SECRET=

# Segredo do webhook /api/webhooks/signature/webhook (CYC-006) — atualização de status de
# assinatura eletrônica. O envio é stub (sem credencial gov.br); este webhook de entrada já é
# real. Fail-closed: sem ele, 503.
SIGNATURE_INBOUND_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# FERRAMENTAS OPEN-SOURCE (OS-1 a OS-8)
# Geradas pela implementação do plano de 50 open-sources (agosto 2026)
# ─────────────────────────────────────────────────────────────────────────────

# OS-3: Flowise — Builder visual de agentes IA (http://localhost:3008)
# FLOWISE_URL é o que src/lib/ai/gateway/providers/litellm.provider.ts usa de fato para rotear
# chamadas com modelo "flowise/..." — as demais variáveis só configuram o próprio serviço Flowise.
FLOWISE_URL=http://localhost:3008
FLOWISE_USERNAME=admin
FLOWISE_PASSWORD=change-this-flowise-password
FLOWISE_SECRET_KEY=change-this-flowise-secret

# OS-3: OpenWebUI (http://localhost:3009)
# OPENWEBUI_URL é o que litellm.provider.ts usa para rotear chamadas com modelo "openwebui/...".
OPENWEBUI_URL=http://localhost:3009
OPENWEBUI_SECRET=change-this-openwebui-secret

# OS-3: mem0 — Memória de agentes IA (self-hosted via Qdrant ou cloud)
MEM0_API_KEY=
MEM0_MODEL=groq/llama-3.3-70b-versatile
MEM0_EMBEDDING_MODEL=text-embedding-3-small

# OS-4: n8n — Automações no-code (http://localhost:5678)
N8N_ENCRYPTION_KEY=change-this-n8n-key-minimum-32-characters
N8N_USER=admin
N8N_PASSWORD=change-this-n8n-password
# N8N_WEBHOOK_URL abaixo é usada nos dois sentidos: pelo próprio serviço n8n para montar suas URLs
# de webhook, e por src/features/automations/infra/N8nWebhookDispatcher.ts para disparar workflows
# a partir da aplicação (ENABLE_N8N_WEBHOOKS precisa estar true também).
N8N_WEBHOOK_URL=http://localhost:5678
ENABLE_N8N_WEBHOOKS=false

# OS-4: Temporal — Workflow engine durável
# (sem variáveis extras além do Postgres já configurado — usa DATABASE_URL)

# OS-4: Apache Superset (http://localhost:8089)
SUPERSET_SECRET_KEY=change-this-superset-key-256bits-minimum
# Usadas só pelo serviço superset-init (docker-compose.services.yml) para criar o usuário admin
# via `superset fab create-admin` — nunca hardcoded no compose.
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_EMAIL=admin@atlasgr.local
SUPERSET_ADMIN_PASSWORD=change-this-superset-admin-password

# OS-4: Redpanda — Event streaming
REDPANDA_BROKERS=localhost:19092

# OS-5: Casdoor — SSO / Identity Provider (http://localhost:8000)
CASDOOR_ENDPOINT=http://localhost:8000
CASDOOR_CLIENT_ID=change-this-casdoor-client-id
CASDOOR_CLIENT_SECRET=change-this-casdoor-client-secret
CASDOOR_ORG_NAME=atlasgr
CASDOOR_APP_NAME=atlasgr-app

# OS-5: Infisical — Gestão de segredos (http://localhost:8200)
INFISICAL_ENCRYPTION_KEY=00000000000000000000000000000000
INFISICAL_AUTH_SECRET=change-this-infisical-auth-secret
INFISICAL_TOKEN=

# OS-5: HashiCorp Vault
VAULT_ROOT_TOKEN=atlas-vault-dev-token
VAULT_ADDR=http://localhost:8201

# OS-5: OPA — Policy as Code (http://localhost:8181)
OPA_URL=http://localhost:8181

# OS-5: Qdrant — Vector Database (http://localhost:6333)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# OS-5: Typesense (opcional, alternativa ao Meilisearch para multi-tenant)
TYPESENSE_API_KEY=atlas-typesense-key
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108

# OS-6: LiveKit — Voz/Vídeo WebRTC (http://localhost:7880)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-this-livekit-secret-minimum-32-chars
LIVEKIT_URL=ws://localhost:7880

# OS-6: Chatwoot — Omnichannel inbox (http://localhost:3005)
CHATWOOT_SECRET_KEY=change-this-chatwoot-secret-key-very-long-string
# hmac_token de assinatura de webhook (gerado pelo Chatwoot por inbox/conta, copiar da UI dele —
# não é o mesmo valor que CHATWOOT_SECRET_KEY acima). Sem isto, POST /api/integrations/chatwoot/
# webhook responde 503 (fail-closed).
CHATWOOT_WEBHOOK_SECRET=

# OS-6: Postal — Email transacional self-hosted
POSTAL_SECRET_KEY=change-this-postal-key

# OS-7: Sentry — Error tracking
SENTRY_DSN=
SENTRY_SECRET_KEY=change-this-sentry-key
VITE_SENTRY_DSN=

# OS-7: Plane — Gestão de projetos (http://localhost:3004)
PLANE_SECRET_KEY=change-this-plane-secret-key

# OS-7: Woodpecker CI
WOODPECKER_AGENT_SECRET=change-this-woodpecker-secret

# OS-7: OpenTelemetry
OTEL_SERVICE_NAME=atlasgr-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=always_on
