NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prospector
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# O acesso em produção é restrito no código a marcelo.nascimento@atlasgr.com.br
# e joao.reis@atlasgr.com.br. Sessões simultâneas permanecem permitidas.
ALLOW_DEV_AUTH_BYPASS=false
API_RATE_LIMIT_MAX=600
AI_RATE_LIMIT_MAX=30
JSON_BODY_LIMIT=2mb
TRUST_PROXY=false
EXPOSE_METRICS=false
ENABLE_SEARCH=false
ENABLE_QUEUES=false
ENRICHMENT_CACHE_TTL_SECONDS=86400

# "free" blocks billable prospecting providers even if a key is present.
# "hybrid" enables each optional provider whose key is configured below.
PROSPECTING_PROVIDER_MODE=free
GOOGLE_MAPS_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
CNPJ_PROVIDER=brasilapi

REDIS_URL=
GEMINI_API_KEY=
GROQ_API_KEY=
LITELLM_URL=http://localhost:4000
LITELLM_KEY=
AI_GATEWAY_TIMEOUT_MS=30000
AI_FALLBACK_TIMEOUT_MS=60000
AI_EMBEDDING_TIMEOUT_MS=30000
