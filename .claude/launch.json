{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prospector-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3005,
      "env": {
        "NODE_ENV": "development",
        "DATABASE_URL": "postgresql://prospector_app:prospector_app_pass@localhost:5434/prospectordb?schema=public",
        "REDIS_URL": "redis://:prospector_redis_pass@localhost:6379",
        "PORT": "3005",
        "BETTER_AUTH_URL": "http://localhost:3005",
        "ALLOWED_ORIGINS": "http://localhost:3005,http://localhost:3000,http://localhost:5173,http://192.168.0.179:3005",
        "OTEL_SDK_DISABLED": "true"
      }
    },
    {
      "name": "prospector-dev-uxcheck",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3009,
      "env": {
        "DATABASE_URL": "postgresql://prospector_app:prospector_app_pass@localhost:5434/prospectordb?schema=public",
        "PORT": "3009",
        "BETTER_AUTH_URL": "http://localhost:3009",
        "ALLOWED_ORIGINS": "http://localhost:3009,http://localhost:3000,http://localhost:5173"
      }
    },
    {
      "name": "portal-comercial-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["http-server", "-p", "8088", "-c-1"],
      "port": 8088
    }
  ]
}
