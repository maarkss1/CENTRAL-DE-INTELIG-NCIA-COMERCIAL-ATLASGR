{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prospector-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3005,
      "env": {
        "DATABASE_URL": "postgresql://prospector_app:prospector_app_pass@localhost:5434/prospectordb?schema=public",
        "PORT": "3005",
        "BETTER_AUTH_URL": "http://localhost:3005",
        "ALLOWED_ORIGINS": "http://localhost:3005,http://localhost:3000,http://localhost:5173"
      }
    }
  ]
}
