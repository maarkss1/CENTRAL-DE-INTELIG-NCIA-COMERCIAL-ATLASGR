{
  "name": "react-example",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "@scarf/scarf@1.4.0": true,
    "@whiskeysockets/baileys@7.0.0-rc13": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "libxmljs2@0.37.0": true,
    "msgpackr-extract@3.0.4": true,
    "msw@2.15.0": true,
    "prisma@7.10.0": true,
    "protobufjs@7.6.5": true,
    "ssh2@1.17.0": true,
    "tesseract.js@7.0.0": true
  },
  "scripts": {
    "postinstall": "prisma generate",
    "ship": "tsc --noEmit && npm run build && git add . && git commit -m \"update: melhorias e ajustes\" && git push origin main",
    "dev": "tsx watch server.ts",
    "dev:worker": "tsx watch worker.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:worker": "esbuild worker.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/worker.cjs",
    "start": "node dist/server.cjs",
    "start:worker": "node dist/worker.cjs",
    "start:e2e": "npx dotenv-cli -e .env.test -- tsx server.ts",
    "preview": "vite preview --port 4173",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "infra:up": "docker compose -f docker-compose.yml -f docker-compose.opensource.yml up -d",
    "infra:down": "docker compose -f docker-compose.yml -f docker-compose.opensource.yml down",
    "local:doctor": "node scripts/local-first/doctor.mjs",
    "auth:emergency-reset": "tsx scripts/emergency-reset-all-passwords.ts",
    "test:containers": "vitest run -c vitest.container.config.ts",
    "test:api-schema": ".\\.venv-opensource\\Scripts\\schemathesis.exe run docs/openapi.yaml --url http://127.0.0.1:3000",
    "load:k6": "docker compose -f docker-compose.yml -f docker-compose.opensource.yml --profile tools run --rm k6",
    "load:k6:crm": "docker compose -f docker-compose.yml -f docker-compose.opensource.yml --profile tools run --rm k6-crm",
    "security:zap": "docker compose -f docker-compose.yml -f docker-compose.opensource.yml --profile tools run --rm zap",
    "security:trivy": "docker compose -f docker-compose.yml -f docker-compose.opensource.yml --profile tools run --rm trivy",
    "security:audit-waivers": "tsx scripts/security/check-audit-waivers.ts",
    "security:sbom": "cyclonedx-npm --output-format JSON --output-reproducible --output-file sbom.cdx.json",
    "security:dependency-inventory": "tsx scripts/security/dependency-inventory.ts",
    "lint:architecture": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json --output-type err src server.ts worker.ts",
    "lint:architecture:baseline": "node scripts/architecture/generate-known-violations-baseline.mjs",
    "check:hotspots": "tsx scripts/architecture/check-hotspots.ts",
    "test:architecture": "npm run lint:architecture && npm run check:hotspots",
    "security:codeql-sarif": "tsx scripts/security/check-codeql-sarif.ts",
    "clean": "rm -rf dist server.js",
    "check:bundle-budget": "node scripts/ci/check-bundle-budget.mjs",
    "check:public-budget": "node scripts/ci/check-public-budget.mjs",
    "lint": "biome lint src",
    "lint:ci": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "pretest:integration": "node scripts/test/prepare-integration-env.js && npx dotenv-cli -e .env.test -- npx prisma migrate deploy",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "pretest:e2e": "node scripts/test/prepare-integration-env.js && npx dotenv-cli -e .env.test -- npx prisma migrate deploy",
    "test:e2e": "npx dotenv-cli -e .env.test -- playwright test",
    "test:watch": "vitest -c vitest.unit.config.ts",
    "coverage": "npm run coverage:unit && npm run coverage:integration",
    "coverage:unit": "vitest run -c vitest.unit.config.ts --coverage",
    "coverage:integration": "vitest run -c vitest.integration.config.ts --coverage",
    "setup:db": "tsx scripts/setup-vector-db.ts",
    "setup:db:check": "tsx scripts/setup-vector-db.ts --check",
    "verify:integrations": "tsx scripts/verify-integrations.ts",
    "verify:ai": "tsx scripts/verify-ai-studio.ts",
    "verify:openapi-drift": "tsx scripts/verify-openapi-drift.ts",
    "eval:golden": "tsx scripts/evaluate-golden-dataset-live.ts",
    "verify:prod": "tsx scripts/verify-prod.ts",
    "reset:passwords": "tsx scripts/reset-passwords.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
